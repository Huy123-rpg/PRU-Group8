# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures
/[Mm]emoryCaptures/

# Asset store packages
/[Aa]ssets/AssetStoreTools*

# Visual Studio / Rider / VSCode generated files
/[Ee]xported[Oo]bj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# OS generated
.DS_Store
Thumbs.db

# .NET build artifacts
[Bb]in/
[Oo]bj/

# Local Secret Keys (Do not commit)
gemini_key.txt
*secret*
*apikey*

# Python & Environment
/scratch/
**/.env
**/.venv/

# Build artifacts & temp exports
/Build_WebGL/
Build_WebGL/
*.zip
*.tar.gz

# Backups and temporary files
*.bak
*.orig_bak
*.backup_pru
*.tmp
*.log

# Debug inspection folders
/menu_inspect/
/scratch_sprites/
