        public enum ToastType
        {
            Info,
            Success,
            Warning,
            Error
        }

        /// <summary>
        /// Tạo Toast Notification chuẩn phong cách fantasy Aurelia:
        /// - Vị trí an toàn ở trên cùng giữa màn hình (Top Center: 0, -22), tuyệt đối KHÔNG đè lên tiêu đề bài học,
        ///   khung "CÂU TRẢ LỜI CỦA BẠN", ảnh xem trước hay các nút bấm.
        /// - Nền xanh navy sang trọng, viền vàng kim, chữ trắng kem sắc nét.
        /// - Tự động biến mất sau 2.5s (thành công) hoặc 4.5s (lỗi).
        /// - Chỉ hiển thị 1 thông báo duy nhất tại một thời điểm, không chồng chữ.
        /// </summary>
        private void EnsureToastNotification()
        {
            Canvas canvas = GetComponentInParent<Canvas>() ?? FindAnyObjectByType<Canvas>();
            if (canvas == null) return;

            // Xóa triệt để object NoticeText cũ nếu còn tồn tại trong Hierarchy
            Transform oldNotice = canvas.transform.Find("NoticeText");
            if (oldNotice != null)
            {
                Destroy(oldNotice.gameObject);
            }

            if (_toastRoot != null) return;

            Transform existingToast = canvas.transform.Find("AureliaToastNotification");
            if (existingToast != null)
            {
                _toastRoot = existingToast.gameObject;
                _toastCanvasGroup = _toastRoot.GetComponent<CanvasGroup>();
                _toastBg = _toastRoot.GetComponent<Image>();
                _toastOutline = _toastRoot.GetComponent<Outline>();
                _toastText = _toastRoot.GetComponentInChildren<TextMeshProUGUI>(true);
                noticeText = _toastText;
                _toastRoot.SetActive(false);
                return;
            }

            _toastRoot = new GameObject("AureliaToastNotification");
            _toastRoot.transform.SetParent(canvas.transform, false);

            RectTransform rt = _toastRoot.AddComponent<RectTransform>();
            rt.anchorMin = new Vector2(0.5f, 1f);
            rt.anchorMax = new Vector2(0.5f, 1f);
            rt.pivot = new Vector2(0.5f, 1f);
            rt.anchoredPosition = new Vector2(0f, -22f);
            rt.sizeDelta = new Vector2(480f, 44f);

            _toastCanvasGroup = _toastRoot.AddComponent<CanvasGroup>();
            _toastCanvasGroup.alpha = 1f;
            _toastCanvasGroup.blocksRaycasts = false;

            _toastBg = _toastRoot.AddComponent<Image>();
            _toastBg.color = new Color(0.06f, 0.12f, 0.24f, 0.96f);

            _toastOutline = _toastRoot.AddComponent<Outline>();
            _toastOutline.effectColor = new Color(0.96f, 0.82f, 0.38f, 1f);
            _toastOutline.effectDistance = new Vector2(1.5f, -1.5f);

            var shadow = _toastRoot.AddComponent<Shadow>();
            shadow.effectColor = new Color(0f, 0f, 0f, 0.65f);
            shadow.effectDistance = new Vector2(2f, -2f);

            var hlg = _toastRoot.AddComponent<HorizontalLayoutGroup>();
            hlg.padding = new RectOffset(20, 20, 8, 8);
            hlg.childAlignment = TextAnchor.MiddleCenter;
            hlg.childControlWidth = true;
            hlg.childControlHeight = true;
            hlg.childForceExpandWidth = false;
            hlg.childForceExpandHeight = false;

            var csf = _toastRoot.AddComponent<ContentSizeFitter>();
            csf.horizontalFit = ContentSizeFitter.FitMode.PreferredSize;
            csf.verticalFit = ContentSizeFitter.FitMode.Unconstrained;

            GameObject txtGo = new GameObject("ToastMessage");
            txtGo.transform.SetParent(_toastRoot.transform, false);
            RectTransform txtRt = txtGo.AddComponent<RectTransform>();
            txtRt.sizeDelta = new Vector2(420f, 30f);

            _toastText = txtGo.AddComponent<TextMeshProUGUI>();
            if (_defaultFont != null) _toastText.font = _defaultFont;
            _toastText.fontSize = 17;
            _toastText.fontStyle = FontStyles.Bold;
            _toastText.alignment = TextAlignmentOptions.Center;
            _toastText.color = new Color(0.98f, 0.96f, 0.90f, 1f);
            _toastText.raycastTarget = false;

            noticeText = _toastText;
            _toastRoot.SetActive(false);
        }

        private void ShowToast(string msg, ToastType type = ToastType.Info, float duration = -1f)
        {
            EnsureToastNotification();
            if (_toastRoot == null || _toastText == null) return;

            if (_toastCoroutine != null)
            {
                StopCoroutine(_toastCoroutine);
                _toastCoroutine = null;
            }

            string plainText = msg;
            if (plainText.Contains("<color="))
            {
                plainText = System.Text.RegularExpressions.Regex.Replace(plainText, @"<color=[^>]+>", "");
                plainText = plainText.Replace("</color>", "");
            }

            _toastText.text = plainText;

            switch (type)
            {
                case ToastType.Success:
                    _toastBg.color = new Color(0.04f, 0.16f, 0.18f, 0.96f);
                    _toastOutline.effectColor = new Color(0.35f, 0.88f, 0.55f, 1f);
                    _toastText.color = new Color(0.85f, 1f, 0.90f, 1f);
                    if (duration <= 0f) duration = 2.5f;
                    break;
                case ToastType.Warning:
                    _toastBg.color = new Color(0.18f, 0.14f, 0.05f, 0.96f);
                    _toastOutline.effectColor = new Color(0.96f, 0.75f, 0.25f, 1f);
                    _toastText.color = new Color(1f, 0.95f, 0.80f, 1f);
                    if (duration <= 0f) duration = 3.5f;
                    break;
                case ToastType.Error:
                    _toastBg.color = new Color(0.20f, 0.06f, 0.08f, 0.96f);
                    _toastOutline.effectColor = new Color(0.95f, 0.40f, 0.40f, 1f);
                    _toastText.color = new Color(1f, 0.88f, 0.88f, 1f);
                    if (duration <= 0f) duration = 4.5f;
                    break;
                default:
                    _toastBg.color = new Color(0.06f, 0.12f, 0.24f, 0.96f);
                    _toastOutline.effectColor = new Color(0.96f, 0.82f, 0.38f, 1f);
                    _toastText.color = new Color(0.98f, 0.96f, 0.90f, 1f);
                    if (duration <= 0f) duration = 3.0f;
                    break;
            }

            _toastRoot.transform.SetAsLastSibling();
            _toastRoot.SetActive(true);
            if (_toastCanvasGroup != null) _toastCanvasGroup.alpha = 1f;

            if (duration > 0f)
            {
                _toastCoroutine = StartCoroutine(ToastFadeRoutine(duration));
            }
        }

        private IEnumerator ToastFadeRoutine(float displayTime)
        {
            yield return new WaitForSeconds(displayTime);

            float fadeTime = 0.25f;
            float elapsed = 0f;
            while (elapsed < fadeTime)
            {
                elapsed += Time.deltaTime;
                if (_toastCanvasGroup != null)
                {
                    _toastCanvasGroup.alpha = Mathf.Lerp(1f, 0f, elapsed / fadeTime);
                }
                yield return null;
            }

            if (_toastRoot != null)
            {
                _toastRoot.SetActive(false);
            }
            _toastCoroutine = null;
        }

        private void ShowNotice(string msg)
        {
            if (string.IsNullOrEmpty(msg)) return;

            if (msg.Contains("✓") || msg.ToLower().Contains("thành công"))
            {
                ShowToast(msg, ToastType.Success, 2.5f);
            }
            else if (msg.Contains("⚠") || msg.Contains("Cảnh báo") || msg.ToLower().Contains("vui lòng"))
            {
                ShowToast(msg, ToastType.Warning, 3.5f);
            }
            else if (msg.Contains("Lỗi") || msg.Contains("Không thể") || msg.Contains("trống") || msg.Contains("thất bại"))
            {
                ShowToast(msg, ToastType.Error, 4.5f);
            }
            else
            {
                ShowToast(msg, ToastType.Info, 3.0f);
            }
        }

        private void SetupActionButtons()
        {
            if (btnBack != null)
            {
                btnBack.onClick.RemoveAllListeners();
                btnBack.onClick.AddListener(OnBackClicked);
            }

            if (btnSubmit != null)
            {
                btnSubmit.onClick.RemoveAllListeners();
                btnSubmit.onClick.AddListener(OnSubmitClicked);
            }

            if (btnUpload != null)
            {
                btnUpload.onClick.RemoveAllListeners();
                btnUpload.onClick.AddListener(OnUploadClicked);
            }

            if (btnDeleteImg != null)
            {
                btnDeleteImg.onClick.RemoveAllListeners();
                btnDeleteImg.onClick.AddListener(OnDeleteImgClicked);
            }

            if (btnPrev != null)
            {
                btnPrev.onClick.RemoveAllListeners();
                btnPrev.onClick.AddListener(OnPrevClicked);
            }

            if (btnNext != null)
            {
                btnNext.onClick.RemoveAllListeners();
                btnNext.onClick.AddListener(OnNextClicked);
            }
        }

        /// <summary>
        /// Nạp 5 câu hỏi tự luận thật từ GameDataRepository theo bài học và mức độ đã chọn.
        /// </summary>
        private void LoadEssayQuestions()
        {
            GameDataRepository.EnsureInitialized();

            string baiId = NavigationService.Instance.Selection != null ? NavigationService.Instance.Selection.LessonId : "bai2";
            string mucDo = NavigationService.Instance.Selection != null ? NavigationService.Instance.Selection.Difficulty : "NB";

            if (string.IsNullOrEmpty(baiId)) baiId = "bai2";
            if (string.IsNullOrEmpty(mucDo)) mucDo = "NB";

            // Nạp đúng 5 câu tự luận chuẩn
            _essayQuestions = GameDataRepository.GetEssayQuestions(baiId, mucDo, 5);

            // Fallback an toàn nếu chưa có đủ
            if (_essayQuestions == null || _essayQuestions.Count == 0)
            {
                if (GameDataRepository.AllEssays != null && GameDataRepository.AllEssays.Count > 0)
                {
                    _essayQuestions = GameDataRepository.AllEssays.Take(5).ToList();
                }
            }

            Debug.Log($"[WrittenAnswerController] Đã nạp {_essayQuestions?.Count ?? 0} câu tự luận cho bài '{baiId}' mức '{mucDo}'.");
        }

        /// <summary>
        /// Hiển thị câu hỏi tại vị trí index (0 đến 4) và cập nhật giao diện hoàn chỉnh.
        /// </summary>
        public void DisplayQuestion(int index)
        {
            if (_essayQuestions == null || _essayQuestions.Count == 0)
            {
                if (questionPromptText != null) questionPromptText.text = "Chưa có câu hỏi tự luận cho bài này.";
                if (counterText != null) counterText.text = "Câu 0/0";
                return;
            }

            // 1. Lưu lại nội dung của câu hiện tại trước khi chuyển
            if (answerInputField != null)
            {
                _userAnswers[_currentIndex] = answerInputField.text;
            }

            _currentIndex = Mathf.Clamp(index, 0, _essayQuestions.Count - 1);
            var q = _essayQuestions[_currentIndex];

            // 2. Cập nhật Đề bài
            if (questionPromptText != null && q != null)
            {
                string diffCode = !string.IsNullOrEmpty(q.mucDoGame2) ? q.mucDoGame2 : "NB";
                string content = !string.IsNullOrEmpty(q.noiDung) ? q.noiDung : "Nội dung câu hỏi tự luận";
                questionPromptText.text = $"<b>CÂU {_currentIndex + 1} ({diffCode}):</b> {content}";
            }

            // 3. Cập nhật Bộ đếm "Câu i/5"
            if (counterText != null)
            {
                counterText.text = $"Câu {_currentIndex + 1}/{_essayQuestions.Count}";
            }

            // 4. Highlight Tab bên sidebar trái: di chuyển nút xanh lá theo đúng câu đang chọn
            for (int i = 0; i < sidebarQuestionButtons.Count; i++)
            {
                if (sidebarQuestionButtons[i] != null)
                {
                    bool exists = (i < _essayQuestions.Count);
                    sidebarQuestionButtons[i].gameObject.SetActive(exists);
                    if (!exists) continue;

                    bool isSelected = (i == _currentIndex);
                    var img = sidebarQuestionButtons[i].GetComponent<Image>();
                    if (img != null)
                    {
                        if (_activeTabSprite != null && _inactiveTabSprite != null && _activeTabSprite != _inactiveTabSprite)
                        {
                            img.sprite = isSelected ? _activeTabSprite : _inactiveTabSprite;
                            img.color = Color.white;
                        }
                        else
                        {
                            img.color = isSelected ? new Color(0.18f, 0.82f, 0.44f, 1f) : new Color(0.12f, 0.22f, 0.42f, 0.90f);
                        }
                    }

                    if (i < sidebarQuestionLabels.Count && sidebarQuestionLabels[i] != null)
                    {
                        sidebarQuestionLabels[i].gameObject.SetActive(exists);
                        sidebarQuestionLabels[i].text = $"Câu {i + 1}";
                        sidebarQuestionLabels[i].color = isSelected ? Color.white : new Color(0.85f, 0.90f, 1f, 0.85f);
                    }
                }
            }

            // 5. Khôi phục bài làm đã lưu của câu này (nếu đã gõ trước đó)
            if (answerInputField != null)
            {
                string savedAnswer = _userAnswers.ContainsKey(_currentIndex) ? _userAnswers[_currentIndex] : "";
                answerInputField.text = savedAnswer;
            }

            // 6. Khôi phục ảnh đã tải lên của câu này (nếu có)
            UpdateImagePreview();

            // 7. Cập nhật trạng thái nút Câu trước / Câu tiếp
            if (btnPrev != null) btnPrev.interactable = (_currentIndex > 0);
            if (btnNext != null) btnNext.interactable = (_currentIndex < _essayQuestions.Count - 1);
        }

        private void UpdateImagePreview()
        {
            bool hasImage = _userImages.ContainsKey(_currentIndex) && _userImages[_currentIndex] != null;
            if (uploadedImagePreview != null)
            {
                if (hasImage)
                {
                    Texture2D tex = _userImages[_currentIndex];
                    uploadedImagePreview.texture = tex;

                    // Giữ đúng tỷ lệ ảnh (Aspect Ratio), nằm gọn trong khung không bị méo và không tràn ra ngoài
                    float maxW = 260f;
                    float maxH = 170f;
                    float aspect = (tex != null && tex.width > 0 && tex.height > 0) ? (float)tex.width / tex.height : 1.33f;

                    float targetW = maxW;
                    float targetH = targetW / aspect;
                    if (targetH > maxH)
                    {
                        targetH = maxH;
                        targetW = targetH * aspect;
                    }

                    RectTransform pRt = uploadedImagePreview.rectTransform;
                    pRt.sizeDelta = new Vector2(targetW, targetH);
                    pRt.anchoredPosition = new Vector2(536.34f, -120f);

                    uploadedImagePreview.gameObject.SetActive(true);
                }
                else
                {
                    uploadedImagePreview.texture = null;
                    uploadedImagePreview.gameObject.SetActive(false);
                }
            }

            if (noImageNoticeText != null)
            {
                noImageNoticeText.gameObject.SetActive(!hasImage);
            }

            // Nút OCR: chỉ bật khi đã có ảnh thật hợp lệ
            if (btnOcr != null)
            {
                btnOcr.interactable = hasImage;
                var ocrImg = btnOcr.GetComponent<Image>();
                if (ocrImg != null)
                {
                    ocrImg.color = hasImage ? new Color(0.08f, 0.20f, 0.42f, 0.95f) : new Color(0.12f, 0.16f, 0.22f, 0.40f);
                }
            }
        }

        private void OnSidebarQuestionClicked(int index)
        {
            DisplayQuestion(index);
        }

        private void OnPrevClicked()
        {
            if (_currentIndex > 0)
            {
                DisplayQuestion(_currentIndex - 1);
            }
        }

        private void OnNextClicked()
        {
            if (_currentIndex < _essayQuestions.Count - 1)
            {
                DisplayQuestion(_currentIndex + 1);
            }
        }

        /// <summary>
        /// Nút "TẢI ẢNH": Mở hộp thoại chọn file ảnh thật từ máy tính (PNG, JPG, JPEG).
        /// Nếu người dùng bấm Cancel hoặc đóng hộp thoại: Tuyệt đối không tạo ảnh giả, không đổi trạng thái.
        /// </summary>
        private void OnUploadClicked()
        {
            Debug.Log($"[WrittenAnswerController] Mở hộp thoại chọn ảnh cho Câu {_currentIndex + 1}.");

            string filePath = SelectImageFile();

            // Nếu người dùng hủy hoặc không chọn file
            if (string.IsNullOrEmpty(filePath))
            {
                Debug.Log("[WrittenAnswerController] Người dùng đã hủy chọn ảnh (Cancel). Giữ nguyên trạng thái.");
                return;
            }

            if (!File.Exists(filePath))
            {
                ShowNotice("<color=#ef4444>Tệp ảnh không tồn tại trên hệ thống.</color>");
                return;
            }

            try
            {
                byte[] bytes = File.ReadAllBytes(filePath);
                Texture2D loadedTex = new Texture2D(2, 2);
                if (loadedTex.LoadImage(bytes))
                {
                    // Giải phóng ảnh cũ của câu này nếu có
                    if (_userImages.ContainsKey(_currentIndex) && _userImages[_currentIndex] != null)
                    {
                        Destroy(_userImages[_currentIndex]);
                    }

                    _userImages[_currentIndex] = loadedTex;
                    _userImageBytes[_currentIndex] = bytes;
                    string ext = Path.GetExtension(filePath).ToLowerInvariant();
                    _userImageMimes[_currentIndex] = (ext == ".jpg" || ext == ".jpeg") ? "image/jpeg" : "image/png";

                    UpdateImagePreview();
                    ShowToast("✓ Tải ảnh thành công! Bấm 'ĐỌC CHỮ OCR' nếu muốn nhận dạng.", ToastType.Success, 2.5f);
                }
                else
                {
                    Destroy(loadedTex);
                    ShowToast("⚠ Không thể tải ảnh: Tệp không đúng định dạng PNG hoặc JPG.", ToastType.Error, 4.5f);
                }
            }
            catch (Exception ex)
            {
                ShowToast($"⚠ Không thể tải ảnh: {ex.Message}", ToastType.Error, 4.5f);
            }
        }

        private string SelectImageFile()
        {
#if UNITY_EDITOR
            return UnityEditor.EditorUtility.OpenFilePanelWithFilters(
                "Chọn ảnh bài làm học sinh (PNG, JPG)",
                "",
                new string[] { "Image files", "png,jpg,jpeg", "All files", "*" });
#else
            return OpenFilePanelWindows("Chọn ảnh bài làm học sinh", "Image Files (*.png;*.jpg;*.jpeg)\0*.png;*.jpg;*.jpeg\0All Files (*.*)\0*.*\0\0");
#endif
        }

#if !UNITY_EDITOR
        [System.Runtime.InteropServices.StructLayout(System.Runtime.InteropServices.LayoutKind.Sequential, CharSet = System.Runtime.InteropServices.CharSet.Auto)]
        public struct OpenFileName
        {
            public int structSize;
            public IntPtr dlgOwner;
            public IntPtr instance;
            public string filter;
            public string customFilter;
            public int maxCustFilter;
            public int filterIndex;
            public string file;
            public int maxFile;
            public string fileTitle;
            public int maxFileTitle;
            public string initialDir;
            public string title;
            public int flags;
            public short fileOffset;
            public short fileExtension;
            public string defExt;
            public IntPtr custData;
            public IntPtr hook;
            public string templateName;
            public IntPtr reservedPtr;
            public int reservedInt;
            public int flagsEx;
        }

        [System.Runtime.InteropServices.DllImport("comdlg32.dll", SetLastError = true, CharSet = System.Runtime.InteropServices.CharSet.Auto)]
        private static extern bool GetOpenFileName([System.Runtime.InteropServices.In, System.Runtime.InteropServices.Out] ref OpenFileName ofn);

        private static string OpenFilePanelWindows(string title, string filter)
        {
            var ofn = new OpenFileName();
            ofn.structSize = System.Runtime.InteropServices.Marshal.SizeOf(ofn);
            ofn.filter = filter;
            ofn.file = new string(new char[260]);
            ofn.maxFile = ofn.file.Length;
            ofn.title = title;
            ofn.flags = 0x00080000 | 0x00001000 | 0x00000800 | 0x00000008;

            if (GetOpenFileName(ref ofn))
            {
                return ofn.file;
            }
            return null;
        }
#endif

        /// <summary>
        /// Nút "XÓA ẢNH": Xóa ảnh đã tải của câu hiện tại.
        /// </summary>
        private void OnDeleteImgClicked()
        {
            if (_userImages.ContainsKey(_currentIndex) && _userImages[_currentIndex] != null)
            {
                Destroy(_userImages[_currentIndex]);
                _userImages[_currentIndex] = null;
                _userImageBytes[_currentIndex] = null;
                _userImageMimes[_currentIndex] = null;
                UpdateImagePreview();
                ShowToast("✓ Đã xóa ảnh bài làm", ToastType.Success, 2.5f);
            }
            else
            {
                ShowToast("⚠ Chưa có ảnh nào được tải lên ở câu này", ToastType.Warning, 3.0f);
            }
        }

        /// <summary>
        /// Nút "📷 ĐỌC CHỮ OCR": Trích xuất văn bản viết tay từ ảnh bài làm qua Google Gemini AI.
        /// Chạy trực tiếp qua endpoint POST /api/ocr_physics trên Backend server.
        /// Cho phép học sinh xem trước và sửa bản chữ trong modal trước khi nộp.
        /// </summary>
        private void OnOcrButtonClicked()
        {
            Texture2D tex = _userImages.ContainsKey(_currentIndex) ? _userImages[_currentIndex] : null;
            byte[] rawBytes = _userImageBytes.ContainsKey(_currentIndex) ? _userImageBytes[_currentIndex] : null;
            string mimeType = _userImageMimes.ContainsKey(_currentIndex) ? _userImageMimes[_currentIndex] : "image/png";

            if (tex == null && (rawBytes == null || rawBytes.Length == 0))
            {
                ShowToast("⚠ Vui lòng tải ảnh bài làm lên trước khi đọc OCR", ToastType.Warning, 3.5f);
                return;
            }

            Debug.Log($"[WrittenAnswerController] Yêu cầu Gemini AI OCR cho Câu {_currentIndex + 1}...");
            ShowToast("⏳ Đang gửi ảnh tới Google Gemini AI để nhận dạng...", ToastType.Info, 12f);

            if (btnOcr != null) btnOcr.interactable = false;

            EssayGradingService.PerformOCRWithGeminiAsync(tex, rawBytes, mimeType, (ocrResult) =>
            {
                if (btnOcr != null) btnOcr.interactable = true;

                if (ocrResult != null && ocrResult.isSuccess && !string.IsNullOrWhiteSpace(ocrResult.transcript))
                {
                    ShowToast("✓ Nhận dạng thành công từ Google Gemini AI!", ToastType.Success, 2.5f);
                    ShowOcrTranscriptModal(ocrResult.transcript);
                }
                else
                {
                    string err = (ocrResult != null && !string.IsNullOrEmpty(ocrResult.errorMessage))
                        ? ocrResult.errorMessage
                        : "Không nhận dạng được chữ trong ảnh. Vui lòng thử ảnh rõ nét hơn.";
                    ShowToast($"⚠ Lỗi OCR: {err}", ToastType.Error, 4.5f);
                }
            });
        }

        private void BuildOcrTranscriptModal()
        {
            Canvas canvas = GetComponentInParent<Canvas>() ?? FindAnyObjectByType<Canvas>();
            if (canvas == null) return;

            // Xóa triệt để modal cũ để luôn cập nhật phiên bản mới có Scrollbar và RectMask2D
            Transform existing = canvas.transform.Find("OcrTranscriptModal");
            if (existing != null)
            {
                Destroy(existing.gameObject);
            }

            ocrModalRoot = new GameObject("OcrTranscriptModal");
            ocrModalRoot.transform.SetParent(canvas.transform, false);

            RectTransform rootRt = ocrModalRoot.AddComponent<RectTransform>();
            rootRt.anchorMin = Vector2.zero;
            rootRt.anchorMax = Vector2.one;
            rootRt.sizeDelta = Vector2.zero;

            Image overlay = ocrModalRoot.AddComponent<Image>();
            overlay.color = new Color(0.04f, 0.08f, 0.16f, 0.90f);
            overlay.raycastTarget = true;

            GameObject card = new GameObject("ModalCard");
            card.transform.SetParent(ocrModalRoot.transform, false);
            RectTransform cardRt = card.AddComponent<RectTransform>();
            cardRt.sizeDelta = new Vector2(840, 560);
            cardRt.anchoredPosition = Vector2.zero;

            Image cardImg = card.AddComponent<Image>();
            cardImg.color = new Color(0.08f, 0.14f, 0.28f, 0.98f);

            Outline cardOutline = card.AddComponent<Outline>();
            cardOutline.effectColor = new Color(0.96f, 0.82f, 0.38f, 1f);
            cardOutline.effectDistance = new Vector2(2, -2);

            // 1. Title
            GameObject titleGo = new GameObject("Title");
            titleGo.transform.SetParent(card.transform, false);
            RectTransform titleRt = titleGo.AddComponent<RectTransform>();
            titleRt.anchoredPosition = new Vector2(0, 235);
            titleRt.sizeDelta = new Vector2(780, 42);
            var titleTmp = titleGo.AddComponent<TextMeshProUGUI>();
            if (_defaultFont != null) titleTmp.font = _defaultFont;
            titleTmp.text = "KIỂM TRA VÀ SỬA BẢN CHỮ NHẬN DẠNG";
            titleTmp.fontSize = 22;
            titleTmp.fontStyle = FontStyles.Bold;
            titleTmp.alignment = TextAlignmentOptions.Center;
            titleTmp.color = new Color(0.96f, 0.82f, 0.38f, 1f);

            // 2. Subtitle
            GameObject subGo = new GameObject("Subtitle");
            subGo.transform.SetParent(card.transform, false);
            RectTransform subRt = subGo.AddComponent<RectTransform>();
            subRt.anchoredPosition = new Vector2(0, 195);
            subRt.sizeDelta = new Vector2(780, 30);
            var subTmp = subGo.AddComponent<TextMeshProUGUI>();
            if (_defaultFont != null) subTmp.font = _defaultFont;
            subTmp.text = "Bạn có thể dùng con lăn chuột để cuộn và chỉnh sửa trực tiếp nội dung dưới đây:";
            subTmp.fontSize = 16;
            subTmp.alignment = TextAlignmentOptions.Center;
            subTmp.color = new Color(0.90f, 0.94f, 1f, 0.90f);

            // 3. Scrollable Input Field Container (Vùng văn bản chiếm diện tích chính)
            GameObject inputGo = new GameObject("OcrInput");
            inputGo.transform.SetParent(card.transform, false);
            RectTransform inRt = inputGo.AddComponent<RectTransform>();
            inRt.anchoredPosition = new Vector2(0, 8);
            inRt.sizeDelta = new Vector2(780, 290);

            Image inBg = inputGo.AddComponent<Image>();
            inBg.color = new Color(0.97f, 0.98f, 1f, 1f);
            inBg.raycastTarget = true;

            Outline inOutline = inputGo.AddComponent<Outline>();
            inOutline.effectColor = new Color(0.20f, 0.35f, 0.60f, 0.45f);
            inOutline.effectDistance = new Vector2(1.5f, -1.5f);

            // 3a. Text Area (Viewport có RectMask2D để giới hạn chữ trong ô trắng)
            GameObject textAreaGo = new GameObject("Text Area");
            textAreaGo.transform.SetParent(inputGo.transform, false);
            RectTransform textAreaRt = textAreaGo.AddComponent<RectTransform>();
            textAreaRt.anchorMin = Vector2.zero;
            textAreaRt.anchorMax = Vector2.one;
            textAreaRt.offsetMin = new Vector2(16f, 12f);
            textAreaRt.offsetMax = new Vector2(-36f, -12f);

            textAreaGo.AddComponent<RectMask2D>();

            // 3b. Text Component
            GameObject textGo = new GameObject("Text");
            textGo.transform.SetParent(textAreaGo.transform, false);
            RectTransform textRt = textGo.AddComponent<RectTransform>();
            textRt.anchorMin = Vector2.zero;
            textRt.anchorMax = Vector2.one;
            textRt.pivot = new Vector2(0f, 1f);
            textRt.offsetMin = Vector2.zero;
            textRt.offsetMax = Vector2.zero;

            TextMeshProUGUI inTmp = textGo.AddComponent<TextMeshProUGUI>();
            if (_defaultFont != null) inTmp.font = _defaultFont;
            inTmp.fontSize = 19;
            inTmp.color = new Color(0.06f, 0.10f, 0.18f, 1f);
            inTmp.textWrappingMode = TextWrappingModes.Normal;
            inTmp.alignment = TextAlignmentOptions.TopLeft;
            inTmp.raycastTarget = false;

            // 3c. Vertical Scrollbar (Thanh cuộn dọc trang nhã, dễ nhìn)
            GameObject scrollbarGo = new GameObject("Scrollbar");
            scrollbarGo.transform.SetParent(inputGo.transform, false);
            RectTransform sbRt = scrollbarGo.AddComponent<RectTransform>();
            sbRt.anchorMin = new Vector2(1f, 0f);
            sbRt.anchorMax = new Vector2(1f, 1f);
            sbRt.pivot = new Vector2(1f, 0.5f);
            sbRt.anchoredPosition = new Vector2(-8f, 0f);
            sbRt.sizeDelta = new Vector2(18f, -20f);

            Image sbBg = scrollbarGo.AddComponent<Image>();
            sbBg.color = new Color(0.86f, 0.90f, 0.95f, 0.85f);
            sbBg.raycastTarget = true;

            GameObject slidingArea = new GameObject("Sliding Area");
            slidingArea.transform.SetParent(scrollbarGo.transform, false);
            RectTransform saRt = slidingArea.AddComponent<RectTransform>();
            saRt.anchorMin = Vector2.zero;
            saRt.anchorMax = Vector2.one;
            saRt.sizeDelta = new Vector2(-18f, -18f);

            GameObject handleGo = new GameObject("Handle");
            handleGo.transform.SetParent(slidingArea.transform, false);
            RectTransform hRt = handleGo.AddComponent<RectTransform>();
            hRt.anchorMin = Vector2.zero;
            hRt.anchorMax = Vector2.one;
            hRt.sizeDelta = new Vector2(18f, 18f);

            Image handleImg = handleGo.AddComponent<Image>();
            handleImg.color = new Color(0.18f, 0.36f, 0.62f, 1f);
            handleImg.raycastTarget = true;

            Scrollbar sb = scrollbarGo.AddComponent<Scrollbar>();
            sb.targetGraphic = handleImg;
            sb.handleRect = hRt;
            sb.direction = Scrollbar.Direction.TopToBottom;
            sb.size = 0.25f;
            sb.value = 0f;

            // 3d. Cấu hình TMP_InputField hoàn chỉnh (dùng AureliaOcrInputField để tránh bug OnScroll của TMP)
            AureliaOcrInputField customInput = inputGo.AddComponent<AureliaOcrInputField>();
            customInput.targetGraphic = inBg;
            customInput.textViewport = textAreaRt;
            customInput.textComponent = inTmp;
            customInput.pointSize = 19;
            customInput.caretColor = new Color(0.06f, 0.10f, 0.18f, 1f);
            customInput.selectionColor = new Color(0.25f, 0.55f, 0.95f, 0.35f);
            customInput.lineType = TMP_InputField.LineType.MultiLineNewline;
            ocrTranscriptInput = customInput;

            // 3e. Quản lý cuộn chuyên dụng: scrollbar drag, mouse wheel, caret sync, layout refresh
            OcrTranscriptScrollManager scrollMgr = inputGo.AddComponent<OcrTranscriptScrollManager>();
            scrollMgr.Setup(ocrTranscriptInput, inTmp, textAreaRt, sb);
            customInput.OnUserScroll = scrollMgr.HandleScrollDelta;

            var fwdTextArea = textAreaGo.AddComponent<OcrScrollForwarder>();
            fwdTextArea.OnScrollEvent = scrollMgr.HandleScrollDelta;

            var fwdSb = scrollbarGo.AddComponent<OcrScrollForwarder>();
            fwdSb.OnScrollEvent = scrollMgr.HandleScrollDelta;

            var fwdHandle = handleGo.AddComponent<OcrScrollForwarder>();
            fwdHandle.OnScrollEvent = scrollMgr.HandleScrollDelta;

            // 4. Fixed Action Buttons (Hàng nút cố định phía dưới, không bị cuộn che)
            // 4a. Nút 1: Confirm (DÙNG BẢN CHỮ NÀY)
            GameObject btnConfirmGo = new GameObject("Btn_ConfirmOcr");
            btnConfirmGo.transform.SetParent(card.transform, false);
            RectTransform cRt = btnConfirmGo.AddComponent<RectTransform>();
            cRt.anchoredPosition = new Vector2(-240, -220);
            cRt.sizeDelta = new Vector2(230, 48);
            Image cImg = btnConfirmGo.AddComponent<Image>();
            cImg.color = new Color(0.12f, 0.58f, 0.32f, 1f);
            btnOcrConfirm = btnConfirmGo.AddComponent<Button>();
            btnOcrConfirm.targetGraphic = cImg;
            GameObject cTxtGo = new GameObject("Text");
            cTxtGo.transform.SetParent(btnConfirmGo.transform, false);
            var cTmp = cTxtGo.AddComponent<TextMeshProUGUI>();
            if (_defaultFont != null) cTmp.font = _defaultFont;
            cTmp.text = "DÙNG BẢN CHỮ NÀY";
            cTmp.fontSize = 17;
            cTmp.fontStyle = FontStyles.Bold;
            cTmp.alignment = TextAlignmentOptions.Center;
            cTmp.color = Color.white;
            cTmp.raycastTarget = false;
            btnOcrConfirm.onClick.AddListener(OnConfirmOcrClicked);

            // 4b. Nút 2: Retry (ĐỌC LẠI)
            GameObject btnRetryGo = new GameObject("Btn_RetryOcr");
            btnRetryGo.transform.SetParent(card.transform, false);
            RectTransform rRt = btnRetryGo.AddComponent<RectTransform>();
            rRt.anchoredPosition = new Vector2(20, -220);
            rRt.sizeDelta = new Vector2(170, 48);
            Image rImg = btnRetryGo.AddComponent<Image>();
            rImg.color = new Color(0.18f, 0.38f, 0.68f, 1f);
            btnOcrRetry = btnRetryGo.AddComponent<Button>();
            btnOcrRetry.targetGraphic = rImg;
            GameObject rTxtGo = new GameObject("Text");
            rTxtGo.transform.SetParent(btnRetryGo.transform, false);
            var rTmp = rTxtGo.AddComponent<TextMeshProUGUI>();
            if (_defaultFont != null) rTmp.font = _defaultFont;
            rTmp.text = "ĐỌC LẠI";
            rTmp.fontSize = 17;
            rTmp.fontStyle = FontStyles.Bold;
            rTmp.alignment = TextAlignmentOptions.Center;
            rTmp.color = Color.white;
            rTmp.raycastTarget = false;
            btnOcrRetry.onClick.AddListener(() =>
            {
                if (ocrModalRoot != null) ocrModalRoot.SetActive(false);
                OnOcrButtonClicked();
            });

            // 4c. Nút 3: Cancel (HỦY)
            GameObject btnCancelGo = new GameObject("Btn_CancelOcr");
            btnCancelGo.transform.SetParent(card.transform, false);
            RectTransform clRt = btnCancelGo.AddComponent<RectTransform>();
            clRt.anchoredPosition = new Vector2(240, -220);
            clRt.sizeDelta = new Vector2(150, 48);
            Image clImg = btnCancelGo.AddComponent<Image>();
            clImg.color = new Color(0.40f, 0.45f, 0.55f, 1f);
            btnOcrCancel = btnCancelGo.AddComponent<Button>();
            btnOcrCancel.targetGraphic = clImg;
            GameObject clTxtGo = new GameObject("Text");
            clTxtGo.transform.SetParent(btnCancelGo.transform, false);
            var clTmp = clTxtGo.AddComponent<TextMeshProUGUI>();
            if (_defaultFont != null) clTmp.font = _defaultFont;
            clTmp.text = "HỦY";
            clTmp.fontSize = 17;
            clTmp.fontStyle = FontStyles.Bold;
            clTmp.alignment = TextAlignmentOptions.Center;
            clTmp.color = Color.white;
            clTmp.raycastTarget = false;
            btnOcrCancel.onClick.AddListener(() => ocrModalRoot.SetActive(false));

            ocrModalRoot.SetActive(false);
        }

                #region === AI TUTOR CHAT MODAL (GIA SƯ AI TRÒ CHUYỆN & SỬA BÀI TỪNG BƯỚC) ===

        private Transform FindDeepChild(Transform parent, string name)
        {
            if (parent == null) return null;
            for (int i = 0; i < parent.childCount; i++)
            {
                var c = parent.GetChild(i);
                if (c.name == name) return c;
                var res = FindDeepChild(c, name);
                if (res != null) return res;
            }
            return null;
        }

        /// <summary>
        /// Đồng bộ hiển thị popup Gia sư AI và kiểm soát triệt để chặn raycast.
        /// Khi đóng: vô hiệu hóa raycast hoàn toàn trên CanvasGroup, Image overlay và GameObject để màn hình Tự luận tương tác bình thường.
        /// Khi mở: kích hoạt raycast, đưa lên trước cùng và tương tác bình thường.
        /// </summary>
        public void SetTutorModalVisible(bool visible)
        {
            if (tutorModalRoot == null) return;

            if (_tutorCanvasGroup == null)
            {
                _tutorCanvasGroup = GetOrAddComponent<CanvasGroup>(tutorModalRoot);
            }

            _tutorCanvasGroup.alpha = visible ? 1f : 0f;
            _tutorCanvasGroup.interactable = visible;
            _tutorCanvasGroup.blocksRaycasts = visible;

            var rootImg = tutorModalRoot.GetComponent<Image>();
            if (rootImg != null)
            {
                rootImg.raycastTarget = visible;
                // Đảm bảo nền mờ tối sẫm che phủ tốt màn hình phía sau (không bị quá trong suốt)
                rootImg.color = new Color(0.02f, 0.04f, 0.08f, 0.88f);
            }

            Transform boardTf = tutorModalRoot.transform.Find("Board_Background");
            if (boardTf != null)
            {
                var boardImg = boardTf.GetComponent<Image>();
                if (boardImg != null)
                {
                    boardImg.raycastTarget = visible;
                }
            }

            tutorModalRoot.SetActive(visible);

            // Ẩn đồng hồ hết giờ khi mở popup để tránh đè lên tiêu đề, và hiện lại khi đóng
            var timerUI = StudySessionTimerUI.Instance ?? FindAnyObjectByType<StudySessionTimerUI>();
            if (timerUI != null)
            {
                timerUI.SetBadgeVisible(!visible);
            }

            if (visible)
            {
                tutorModalRoot.transform.SetAsLastSibling();
                if (tutorChatScrollRect != null)
                {
                    ScrollToBottomDelayed();
                }
                if (tutorChatInputField != null)
                {
                    tutorChatInputField.ActivateInputField();
                }
            }

            Debug.Log($"[WrittenAnswerController] SetTutorModalVisible: {visible} (blocksRaycasts={_tutorCanvasGroup.blocksRaycasts}, active={tutorModalRoot.activeSelf})");
        }

        /// <summary>
        /// Khởi tạo và liên kết trực tiếp với Popup Gia sư AI đã được người dùng thiết kế sẵn trong Unity (AITutorPopup).
        /// TUYỆT ĐỐI không tự sinh GameObject modal mới đè lên thiết kế của người dùng.
        /// </summary>
        private void InitCustomAiTutorModal()
        {
            Canvas canvas = GetComponentInParent<Canvas>() ?? FindAnyObjectByType<Canvas>();
            if (canvas == null) return;

            // Xóa bất kỳ modal nào từng sinh tự động trước đây để không bao giờ bị trùng lặp
            Transform oldGen = canvas.transform.Find("AiTutorModal");
            if (oldGen != null) DestroyImmediate(oldGen.gameObject);
            Transform oldGen2 = canvas.transform.Find("Aurelia_AiTutorModal");
            if (oldGen2 != null) DestroyImmediate(oldGen2.gameObject);

            // Tìm popup Gia sư AI chính do người dùng thiết kế
            Transform popupTf = canvas.transform.Find("AITutorPopup");
            if (popupTf == null)
            {
                Debug.LogWarning("[WrittenAnswerController] Không tìm thấy 'AITutorPopup' trong Canvas.");
                return;
            }

            tutorModalRoot = popupTf.gameObject;
            _tutorCanvasGroup = GetOrAddComponent<CanvasGroup>(tutorModalRoot);

            // 1. Tiêu đề Header
            Transform titleTf = FindDeepChild(popupTf, "Text_Title");
            if (titleTf != null)
            {
                tutorHeaderTitle = titleTf.GetComponent<TextMeshProUGUI>();
                if (tutorHeaderTitle != null) tutorHeaderTitle.raycastTarget = false;
            }

            // 2. Nút X ĐÓNG ở góc trên bên phải
            Transform btnCloseTopTf = FindDeepChild(popupTf, "Btn_CloseTopRight");
            if (btnCloseTopTf != null)
            {
                var btnX = GetOrAddComponent<Button>(btnCloseTopTf);
                btnX.targetGraphic = btnCloseTopTf.GetComponent<Image>();
                btnX.onClick.RemoveAllListeners();
                btnX.onClick.AddListener(() =>
                {
                    OnTutorDismissClicked();
                });
                UIHoverPulseEffect.Attach(btnCloseTopTf.gameObject, hover: 1.08f, minPulse: 1.04f, maxPulse: 1.09f, outline: true);
            }

            // 3. Tiến độ bài làm
            Transform progressSummaryTf = FindDeepChild(popupTf, "Text_ProgressSummary");
            if (progressSummaryTf != null)
            {
                tutorStepProgressText = progressSummaryTf.GetComponent<TextMeshProUGUI>();
                if (tutorStepProgressText != null) tutorStepProgressText.raycastTarget = false;
            }

            // 4. Các thẻ Bước (Step Badges)
            _stepBadgeRoots.Clear();
            _stepBadgeTexts.Clear();

            void SetupBadge(string badgeName, string textName, ref Sprite spriteRef)
            {
                Transform b = FindDeepChild(popupTf, badgeName);
                Transform t = FindDeepChild(popupTf, textName);
                if (b != null)
                {
                    _stepBadgeRoots.Add(b.gameObject);
                    var img = b.GetComponent<Image>();
                    if (img != null && spriteRef == null) spriteRef = img.sprite;

                    if (t != null)
                    {
                        t.SetParent(b, false);
                        RectTransform tRt = t as RectTransform;
                        if (tRt != null)
                        {
                            tRt.anchorMin = Vector2.zero;
                            tRt.anchorMax = Vector2.one;
                            tRt.offsetMin = Vector2.zero;
                            tRt.offsetMax = Vector2.zero;
                        }
                        var tmp = t.GetComponent<TextMeshProUGUI>();
                        if (tmp != null)
                        {
                            tmp.alignment = TextAlignmentOptions.Center;
                            tmp.raycastTarget = false;
                            tmp.fontSize = 28;
                            _stepBadgeTexts.Add(tmp);
                        }
                    }
                }
            }

            SetupBadge("Badge_Step1", "Text_Step1", ref _badgeSpriteCorrect);
            Sprite dummy = null;
            SetupBadge("Badge_Step2", "Text_Step2", ref dummy);
            SetupBadge("Badge_Step3", "Text_Step3", ref _badgeSpriteIncorrect);

            // 5. Mẫu khung chat (AI & Học sinh)
            Transform aiBubbleTf = FindDeepChild(popupTf, "Template_AiBubble");
            Transform studentBubbleTf = FindDeepChild(popupTf, "Template_StudentBubble");
            Transform aiSenderTf = FindDeepChild(popupTf, "Text_AiSender");
            Transform aiMsgTf = FindDeepChild(popupTf, "Text_AiMessage");
            Transform stuSenderTf = FindDeepChild(popupTf, "Text_StudentSender");
            Transform stuMsgTf = FindDeepChild(popupTf, "Text_StudentMessage");

            if (aiBubbleTf != null)
            {
                _templateAiBubble = aiBubbleTf.gameObject;
                var img = _templateAiBubble.GetComponent<Image>();
                if (img != null) _aiBubbleSprite = img.sprite;
                _templateAiBubble.SetActive(false);
            }
            if (studentBubbleTf != null)
            {
                _templateStudentBubble = studentBubbleTf.gameObject;
                var img = _templateStudentBubble.GetComponent<Image>();
                if (img != null) _studentBubbleSprite = img.sprite;
                _templateStudentBubble.SetActive(false);
            }

            // Ẩn hoàn toàn các câu chat mẫu dùng để thiết kế (không giữ lại câu chat mẫu)
            if (aiSenderTf != null) aiSenderTf.gameObject.SetActive(false);
            if (aiMsgTf != null) aiMsgTf.gameObject.SetActive(false);
            if (stuSenderTf != null) stuSenderTf.gameObject.SetActive(false);
            if (stuMsgTf != null) stuMsgTf.gameObject.SetActive(false);

            // 6. ScrollRect khu vực trò chuyện (Lịch sử chat cuộn dọc)
            Transform scrollTf = popupTf.Find("Chat_ScrollView");
            if (scrollTf == null)
            {
                GameObject scrollGo = new GameObject("Chat_ScrollView");
                scrollGo.transform.SetParent(popupTf, false);
                RectTransform sRt = scrollGo.AddComponent<RectTransform>();
                sRt.anchorMin = new Vector2(0.5f, 0.5f);
                sRt.anchorMax = new Vector2(0.5f, 0.5f);
                sRt.pivot = new Vector2(0.5f, 0.5f);
                sRt.anchoredPosition = new Vector2(0f, -57.5f);
                sRt.sizeDelta = new Vector2(1420f, 415f);

                // Nền mờ sẫm màu phía sau vùng chat chống bị nhìn xuyên thấu
                Image sImg = scrollGo.AddComponent<Image>();
                sImg.color = new Color(0.02f, 0.05f, 0.10f, 0.70f);
                sImg.raycastTarget = false;

                tutorChatScrollRect = scrollGo.AddComponent<ScrollRect>();
                tutorChatScrollRect.horizontal = false;
                tutorChatScrollRect.vertical = true;
                tutorChatScrollRect.movementType = ScrollRect.MovementType.Clamped;
                tutorChatScrollRect.scrollSensitivity = 35f;

                GameObject vpGo = new GameObject("Viewport");
                vpGo.transform.SetParent(scrollGo.transform, false);
                RectTransform vpRt = vpGo.AddComponent<RectTransform>();
                vpRt.anchorMin = Vector2.zero;
                vpRt.anchorMax = Vector2.one;
                vpRt.sizeDelta = Vector2.zero;
                Image vpImg = vpGo.AddComponent<Image>();
                vpImg.color = new Color(0, 0, 0, 0.001f);
                vpImg.raycastTarget = true;
                vpGo.AddComponent<RectMask2D>();
                tutorChatScrollRect.viewport = vpRt;

                GameObject ctGo = new GameObject("Content");
                ctGo.transform.SetParent(vpGo.transform, false);
                tutorChatContainer = ctGo.AddComponent<RectTransform>();
                tutorChatContainer.anchorMin = new Vector2(0f, 1f);
                tutorChatContainer.anchorMax = new Vector2(1f, 1f);
                tutorChatContainer.pivot = new Vector2(0.5f, 1f);
                tutorChatContainer.anchoredPosition = Vector2.zero;
                tutorChatContainer.sizeDelta = new Vector2(0f, 0f);

                VerticalLayoutGroup vlg = ctGo.AddComponent<VerticalLayoutGroup>();
                vlg.padding = new RectOffset(16, 16, 12, 12);
                vlg.spacing = 14f;
                vlg.childControlWidth = true;
                vlg.childControlHeight = true;
                vlg.childForceExpandWidth = true;
                vlg.childForceExpandHeight = false;

                ContentSizeFitter csf = ctGo.AddComponent<ContentSizeFitter>();
                csf.horizontalFit = ContentSizeFitter.FitMode.Unconstrained;
                csf.verticalFit = ContentSizeFitter.FitMode.PreferredSize;

                tutorChatScrollRect.content = tutorChatContainer;
            }
            else
            {
                tutorChatScrollRect = scrollTf.GetComponent<ScrollRect>();
                Transform ct = scrollTf.Find("Viewport/Content");
                if (ct != null)
                {
                    tutorChatContainer = ct as RectTransform;
                    var vlg = ct.GetComponent<VerticalLayoutGroup>();
                    if (vlg != null)
                    {
                        vlg.padding = new RectOffset(16, 16, 12, 12);
                        vlg.spacing = 14f;
                        vlg.childControlWidth = true;
                        vlg.childControlHeight = true;
                        vlg.childForceExpandWidth = true;
                        vlg.childForceExpandHeight = false;
                    }
                }
            }

            // 7. Khung nhập văn bản (Box_InputField)
            Transform boxTf = FindDeepChild(popupTf, "Box_InputField");
            Transform phTf = FindDeepChild(popupTf, "Text_InputPlaceholder");
            if (boxTf != null)
            {
                // Gỡ bỏ component Button đi lạc nếu có từ lần chạy trước
                var strayBtn = boxTf.GetComponent<Button>();
                if (strayBtn != null) DestroyImmediate(strayBtn);

                var boxImg = boxTf.GetComponent<Image>();
                if (boxImg != null) boxImg.raycastTarget = true;

                // Cấu hình vùng an toàn bên trong khung nhập fantasy:
                // - Chừa 105px bên trái: Vượt hoàn toàn qua biểu tượng cây bút ở góc trái (vùng icon kết thúc ở ~90-100px)
                // - Chừa 24px bên phải: Tránh viền khung mỹ thuật
                // - Chừa 18px trên/dưới: Tránh viền trang trí fantasy
                float padLeft = 105f;
                float padRight = -24f;
                float padBottom = 18f;
                float padTop = -18f;

                Transform textAreaTf = boxTf.Find("TextArea");
                RectTransform taRt = null;
                if (textAreaTf == null)
                {
                    GameObject taGo = new GameObject("TextArea");
                    taGo.transform.SetParent(boxTf, false);
                    taRt = taGo.AddComponent<RectTransform>();
                    taRt.anchorMin = Vector2.zero;
                    taRt.anchorMax = Vector2.one;
                    taRt.offsetMin = new Vector2(padLeft, padBottom);
                    taRt.offsetMax = new Vector2(padRight, padTop);
                    taGo.AddComponent<RectMask2D>();
                    textAreaTf = taGo.transform;
                }
                else
                {
                    taRt = textAreaTf as RectTransform;
                    if (taRt != null)
                    {
                        taRt.anchorMin = Vector2.zero;
                        taRt.anchorMax = Vector2.one;
                        taRt.offsetMin = new Vector2(padLeft, padBottom);
                        taRt.offsetMax = new Vector2(padRight, padTop);
                    }
                    if (textAreaTf.GetComponent<RectMask2D>() == null)
                    {
                        textAreaTf.gameObject.AddComponent<RectMask2D>();
                    }
                }

                // Placeholder: Thuộc về TextArea, tuân thủ đúng vùng an toàn chữ viết
                TextMeshProUGUI phTmp = null;
                if (phTf != null)
                {
                    phTf.SetParent(textAreaTf, false);
                    RectTransform phRt = phTf as RectTransform;
                    if (phRt != null)
                    {
                        phRt.anchorMin = Vector2.zero;
                        phRt.anchorMax = Vector2.one;
                        phRt.offsetMin = Vector2.zero;
                        phRt.offsetMax = Vector2.zero;
                    }
                    phTmp = phTf.GetComponent<TextMeshProUGUI>();
                    if (phTmp != null)
                    {
                        phTmp.fontSize = 22;
                        phTmp.fontStyle = FontStyles.Italic;
                        phTmp.color = new Color(0.70f, 0.80f, 0.95f, 0.65f);
                        phTmp.alignment = TextAlignmentOptions.TopLeft;
                        phTmp.margin = new Vector4(0f, 4f, 0f, 4f);
                        phTmp.textWrappingMode = TextWrappingModes.Normal;
                        phTmp.raycastTarget = false;
                    }
                }

                // Text Component: Chữ học sinh gõ bắt đầu chính xác cùng vùng an toàn với Placeholder
                Transform textTf = textAreaTf.Find("Text");
                TextMeshProUGUI textTmp = null;
                if (textTf == null)
                {
                    GameObject textGo = new GameObject("Text");
                    textGo.transform.SetParent(textAreaTf, false);
                    RectTransform tRt = textGo.AddComponent<RectTransform>();
                    tRt.anchorMin = Vector2.zero;
                    tRt.anchorMax = Vector2.one;
                    tRt.offsetMin = Vector2.zero;
                    tRt.offsetMax = Vector2.zero;
                    textTmp = textGo.AddComponent<TextMeshProUGUI>();
                    if (_defaultFont != null) textTmp.font = _defaultFont;
                    textTmp.fontSize = 22;
                    textTmp.color = Color.white;
                    textTmp.alignment = TextAlignmentOptions.TopLeft;
                    textTmp.margin = new Vector4(0f, 4f, 0f, 4f);
                    textTmp.textWrappingMode = TextWrappingModes.Normal;
                    textTmp.raycastTarget = false;
                }
                else
                {
                    textTmp = textTf.GetComponent<TextMeshProUGUI>();
                    if (textTmp != null)
                    {
                        textTmp.fontSize = 22;
                        textTmp.alignment = TextAlignmentOptions.TopLeft;
                        textTmp.margin = new Vector4(0f, 4f, 0f, 4f);
                        textTmp.raycastTarget = false;
                    }
                }

                tutorChatInputField = boxTf.GetComponent<TMP_InputField>();
                if (tutorChatInputField == null)
                {
                    tutorChatInputField = boxTf.gameObject.AddComponent<TMP_InputField>();
                }

                tutorChatInputField.targetGraphic = boxImg;
                tutorChatInputField.textViewport = taRt;
                tutorChatInputField.textComponent = textTmp;
                tutorChatInputField.placeholder = phTmp;
                tutorChatInputField.lineType = TMP_InputField.LineType.MultiLineNewline;
                tutorChatInputField.interactable = true;
                tutorChatInputField.readOnly = false;
                tutorChatInputField.onSubmit.RemoveAllListeners();
                tutorChatInputField.onSubmit.AddListener((val) =>
                {
                    if (Input.GetKey(KeyCode.LeftShift) || Input.GetKey(KeyCode.RightShift)) return;
                    OnSendTutorChatClicked();
                });
            }

            // 8. Nút GỬI
            Transform btnSendTf = FindDeepChild(popupTf, "Btn_Send");
            if (btnSendTf != null)
            {
                btnTutorSend = GetOrAddComponent<Button>(btnSendTf);
                btnTutorSend.targetGraphic = btnSendTf.GetComponent<Image>();
                btnTutorSend.onClick.RemoveAllListeners();
                btnTutorSend.onClick.AddListener(OnSendTutorChatClicked);

                Transform textSendTf = FindDeepChild(popupTf, "Text_SendLabel");
                if (textSendTf != null)
                {
                    textSendTf.SetParent(btnSendTf, false);
                    RectTransform stRt = textSendTf as RectTransform;
                    if (stRt != null)
                    {
                        // Dat text o 65% ben phai cua nut (0.35..0.96) de khong bao gio de len icon ben trai
                        stRt.anchorMin = new Vector2(0.35f, 0f);
                        stRt.anchorMax = new Vector2(0.96f, 1f);
                        stRt.offsetMin = Vector2.zero;
                        stRt.offsetMax = Vector2.zero;
                    }
                    var tmp = textSendTf.GetComponent<TextMeshProUGUI>();
                    if (tmp != null)
                    {
                        tmp.text = "GỬI";
                        tmp.alignment = TextAlignmentOptions.Center;
                        tmp.raycastTarget = false;
                        tmp.fontSize = 26;
                        tmp.fontStyle = FontStyles.Bold;
                        tmp.color = Color.white;
                        btnTutorSendText = tmp;
                    }
                }
                UIHoverPulseEffect.Attach(btnSendTf.gameObject, hover: 1.08f, minPulse: 1.04f, maxPulse: 1.09f, outline: true);
            }

            // 9. Nút ĐÓNG (dưới cùng)
            Transform btnCloseBottomTf = FindDeepChild(popupTf, "Btn_CloseBottom");
            if (btnCloseBottomTf != null)
            {
                btnTutorDismiss = GetOrAddComponent<Button>(btnCloseBottomTf);
                btnTutorDismiss.targetGraphic = btnCloseBottomTf.GetComponent<Image>();
                btnTutorDismiss.onClick.RemoveAllListeners();
                btnTutorDismiss.onClick.AddListener(() =>
                {
                    OnTutorDismissClicked();
                });

                Transform textCloseTf = FindDeepChild(popupTf, "Text_CloseLabel");
                if (textCloseTf != null)
                {
                    textCloseTf.SetParent(btnCloseBottomTf, false);
                    RectTransform ctRt = textCloseTf as RectTransform;
                    if (ctRt != null)
                    {
                        // Dat text o 65% ben phai cua nut (0.35..0.96) de khong bao gio de len icon X ben trai
                        ctRt.anchorMin = new Vector2(0.35f, 0f);
                        ctRt.anchorMax = new Vector2(0.96f, 1f);
                        ctRt.offsetMin = Vector2.zero;
                        ctRt.offsetMax = Vector2.zero;
                    }
                    var tmp = textCloseTf.GetComponent<TextMeshProUGUI>();
                    if (tmp != null)
                    {
                        tmp.text = "ĐÓNG";
                        tmp.alignment = TextAlignmentOptions.Center;
                        tmp.raycastTarget = false;
                        tmp.fontSize = 26;
                        tmp.fontStyle = FontStyles.Bold;
                        tmp.color = Color.white;
                    }
                }
                UIHoverPulseEffect.Attach(btnCloseBottomTf.gameObject, hover: 1.08f, minPulse: 1.04f, maxPulse: 1.09f, outline: true);
            }

            // Đảm bảo Box_InputField, Btn_Send và các nút bấm luôn ở lớp trên cùng của popup để không bị che khuất
            if (boxTf != null) boxTf.SetAsLastSibling();
            if (btnSendTf != null) btnSendTf.SetAsLastSibling();
            if (btnCloseBottomTf != null) btnCloseBottomTf.SetAsLastSibling();
            if (btnCloseTopTf != null) btnCloseTopTf.SetAsLastSibling();

            // 10. Mặc định ẩn popup hoàn toàn và triệt tiêu raycast
            SetTutorModalVisible(false);
            Debug.Log("[WrittenAnswerController] InitCustomAiTutorModal hoàn tất thành công.");
        }

        private void OnAiTutorClicked()
        {
            Debug.Log($"[WrittenAnswerController] Mở Gia sư AI tương tác cho Câu {_currentIndex + 1}.");

            if (answerInputField != null)
            {
                _userAnswers[_currentIndex] = answerInputField.text;
            }

            // Nếu câu này đã hoàn thành các bước hướng dẫn nhưng vẫn còn nợ phần Chép sửa kiến thức 1 lần:
            if (_needsCorrection.ContainsKey(_currentIndex) && _needsCorrection[_currentIndex] &&
                (!_hasCompletedCorrection.ContainsKey(_currentIndex) || !_hasCompletedCorrection[_currentIndex]) &&
                _tutorCompletedStates.ContainsKey(_currentIndex) && _tutorCompletedStates[_currentIndex])
            {
                OpenKnowledgeCorrectionPopup(_currentIndex);
                return;
            }

            if (tutorModalRoot == null) InitCustomAiTutorModal();
            if (tutorModalRoot == null) return;

            SetTutorModalVisible(true);

            // Kiểm tra xem câu này đã có lịch sử chat trước đó chưa
            if (_tutorChatHistories.ContainsKey(_currentIndex) && _tutorChatHistories[_currentIndex].Count > 0)
            {
                RenderExistingChatSession(_currentIndex);
            }
            else
            {
                StartNewTutorChatSession(_currentIndex);
            }
        }

        private void StartNewTutorChatSession(int qIndex)
        {
            ClearChatContainer();

            if (!_tutorChatHistories.ContainsKey(qIndex))
            {
                _tutorChatHistories[qIndex] = new List<TutorChatMessage>();
            }
            if (!_tutorActiveStepIds.ContainsKey(qIndex))
            {
                _tutorActiveStepIds[qIndex] = "";
            }
            if (!_tutorCompletedStates.ContainsKey(qIndex))
            {
                _tutorCompletedStates[qIndex] = false;
            }

            if (tutorStepProgressText != null)
            {
                tutorStepProgressText.text = "Tiến độ bài làm: <b>Đang phân tích...</b>";
            }

            SetTutorInputInteractable(false);
            var initWaitBubble = AddChatMessageBubble("system", "⏳ Gia sư AI Aurelia đang đọc đề bài, rubric và bài làm hiện tại của bạn...");

            string currentAnswer = _userAnswers.ContainsKey(qIndex) ? _userAnswers[qIndex].Trim() : "";
            _initialDraftsBeforeTutor[qIndex] = currentAnswer;
            var currentQ = (_essayQuestions != null && qIndex < _essayQuestions.Count) ? _essayQuestions[qIndex] : null;
            string cauHoiId = (currentQ != null) ? currentQ.cauHoiID : "TL_C1_L2_Duy";

            var payload = new TutorChatRequestPayload
            {
                cauHoiId = cauHoiId,
                currentEssay = currentAnswer,
                studentMessage = "", // Lượt phân tích & chẩn đoán ban đầu
                activeStepId = "",
                chatHistory = new List<TutorChatMessage>()
            };

            // 1. Kiểm tra nhanh trạng thái kết nối Backend trước (timeout 3 giây)
            EssayGradingService.CheckBackendHealthAsync((isOnline, healthErr) =>
            {
                if (!isOnline)
                {
                    if (initWaitBubble != null) Destroy(initWaitBubble);
                    if (tutorStepProgressText != null)
                    {
                        tutorStepProgressText.text = "Tiến độ bài làm: <color=#FFA726>Chưa kết nối Backend</color>";
                    }
                    SetTutorInputInteractable(true);
                    AddChatMessageBubble("system", "⚠ <b>Backend Server (Port 5050) chưa được bật!</b>\n" +
                        "Vui lòng chạy file <code>start_gemini_server.bat</code> trong thư mục dự án để khởi động backend Gia sư AI.\n" +
                        "<i>Sau khi server chạy, bạn có thể gõ nội dung hoặc bấm <b>GỬI</b> để thử lại ngay.</i>");
                    ScrollToBottomDelayed();
                    return;
                }

                // 2. Backend đang online -> gửi yêu cầu tương tác tới Gemini
                EssayGradingService.SendTutorChatAsync(payload, (res) =>
                {
                    if (initWaitBubble != null) Destroy(initWaitBubble);

                    if (_currentIndex != qIndex)
                    {
                        if (res != null && res.success) SaveChatSessionResponse(qIndex, res);
                        return;
                    }

                    SetTutorInputInteractable(true);

                    if (res == null || !res.success)
                    {
                        if (tutorStepProgressText != null)
                        {
                            tutorStepProgressText.text = "Tiến độ bài làm: <color=#FF7043>Chưa kết nối AI</color>";
                        }
                        string errMsg = !string.IsNullOrEmpty(res?.message) ? res.message : (!string.IsNullOrEmpty(res?.error) ? res.error : "Không thể kết nối Gemini API.");
                        AddChatMessageBubble("system", $"⚠ Không thể kết nối Gia sư AI: {errMsg}\n<i>Bạn có thể nhập tin nhắn hoặc bấm <b>GỬI</b> để thử lại.</i>");
                        ScrollToBottomDelayed();
                        return;
                    }

                    SaveChatSessionResponse(qIndex, res);
                    RenderExistingChatSession(qIndex);
                });
            });
        }

        private void RenderExistingChatSession(int qIndex)
        {
            ClearChatContainer();

            // 1. Cập nhật Step Badges
            if (_tutorStepStates.ContainsKey(qIndex) && _tutorStepStates[qIndex] != null)
            {
                UpdateStepBadges(_tutorStepStates[qIndex]);
            }

            // 2. Render lại các tin nhắn đã có
            if (_tutorChatHistories.ContainsKey(qIndex) && _tutorChatHistories[qIndex] != null)
            {
                foreach (var msg in _tutorChatHistories[qIndex])
                {
                    AddChatMessageBubble(msg.role, msg.text);
                }
            }

            // 3. Trạng thái hoàn thành
            if (_tutorCompletedStates.ContainsKey(qIndex) && _tutorCompletedStates[qIndex])
            {
                AddChatMessageBubble("system", "🎉 <b>XUẤT SẮC! BẠN ĐÃ HOÀN THÀNH TOÀN BỘ CÁC BƯỚC CỦA BÀI NÀY!</b>\nBấm <b>ĐÓNG</b> để kiểm tra lại bài hoặc bấm <b>NỘP BÀI</b>.");
            }

            ScrollToBottomDelayed();
        }

        private void SaveChatSessionResponse(int qIndex, TutorChatResponse res)
        {
            if (res == null) return;

            if (res.steps != null && res.steps.Count > 0)
            {
                _tutorStepStates[qIndex] = res.steps;
            }

            if (!string.IsNullOrEmpty(res.activeStepId))
            {
                _tutorActiveStepIds[qIndex] = res.activeStepId;
            }

            _tutorCompletedStates[qIndex] = res.isAllCompleted;

            // Đánh giá lần đầu tiên để xác định xem bài có cần chép sửa 1 lần không
            if (!_hasInitialAssessment.ContainsKey(qIndex))
            {
                _hasInitialAssessment[qIndex] = true;
                string initialDraft = _initialDraftsBeforeTutor.ContainsKey(qIndex) ? _initialDraftsBeforeTutor[qIndex] : "";
                bool hadMeaningfulDraft = !string.IsNullOrWhiteSpace(initialDraft) && initialDraft.Length >= 5;

                bool hasActualError = false;
                if (res.steps != null && res.steps.Count > 0)
                {
                    hasActualError = res.steps.Any(s => s.status == "incorrect" || s.status == "partial");
                }
                if (!res.isAllCompleted && hadMeaningfulDraft)
                {
                    hasActualError = true;
                }

                if (hadMeaningfulDraft && hasActualError)
                {
                    _needsCorrection[qIndex] = true;
                    Debug.Log($"[WrittenAnswerController] Câu {qIndex + 1} được đánh dấu CẦN CHÉP SỬA KIẾN THỨC (có bài làm ban đầu nhưng bị lỗi).");
                }
                else
                {
                    _needsCorrection[qIndex] = false;
                    Debug.Log($"[WrittenAnswerController] Câu {qIndex + 1} KHÔNG cần chép sửa (đã đúng ngay từ đầu hoặc chưa làm).");
                }
            }

            if (!string.IsNullOrEmpty(res.tutorReply))
            {
                if (!_tutorChatHistories.ContainsKey(qIndex))
                {
                    _tutorChatHistories[qIndex] = new List<TutorChatMessage>();
                }
                _tutorChatHistories[qIndex].Add(new TutorChatMessage { role = "assistant", text = res.tutorReply });
            }

            // Tự động đồng bộ bài làm nếu Gemini đã kiểm tra bước sửa là ĐÚNG
            if (res.isCurrentStepCorrect && !string.IsNullOrEmpty(res.updatedFullEssay))
            {
                _userAnswers[qIndex] = res.updatedFullEssay;
                if (_currentIndex == qIndex && answerInputField != null)
                {
                    answerInputField.text = res.updatedFullEssay;

                }
                Debug.Log($"[WrittenAnswerController] Tự động đồng bộ bài làm Câu {qIndex + 1} ({res.updatedFullEssay.Length} ký tự).");
            }
        }

        private void OnSendTutorChatClicked()
        {
            if (tutorChatInputField == null) return;
            int qIndex = _currentIndex;
            string text = tutorChatInputField.text != null ? tutorChatInputField.text.Trim() : "";

            // Nếu ô nhập trống nhưng chưa có tin nhắn học sinh nào (hoặc lần đầu bị lỗi), cho phép bấm Gửi để thử kết nối lại
            bool hasUserMessages = _tutorChatHistories.ContainsKey(qIndex) && _tutorChatHistories[qIndex].Any(m => m.role == "user");
            if (string.IsNullOrEmpty(text))
            {
                if (!hasUserMessages)
                {
                    StartNewTutorChatSession(qIndex);
                }
                return;
            }


            if (_tutorCompletedStates.ContainsKey(qIndex) && _tutorCompletedStates[qIndex])
            {
                ShowToast("Bạn đã hoàn thành trọn vẹn bài giải này! Hãy bấm ĐÓNG để xem lại bài.", ToastType.Success, 3.5f);
                return;
            }

            // Dọn ô nhập và ghi nhận tin nhắn học sinh
            tutorChatInputField.text = "";
            if (!_tutorChatHistories.ContainsKey(qIndex))
            {
                _tutorChatHistories[qIndex] = new List<TutorChatMessage>();
            }

            var studentMsg = new TutorChatMessage { role = "user", text = text };
            _tutorChatHistories[qIndex].Add(studentMsg);
            AddChatMessageBubble("user", text);
            ScrollToBottomDelayed();

            // Khóa tương tác trong lúc chờ Gemini phản hồi
            SetTutorInputInteractable(false);
            if (btnTutorSendText != null) btnTutorSendText.text = "⏳";

            var waitBubble = AddChatMessageBubble("system", "⏳ Gia sư AI đang chấm câu sửa của bạn...");
            ScrollToBottomDelayed();

            string currentAnswer = _userAnswers.ContainsKey(qIndex) ? _userAnswers[qIndex] : "";
            var currentQ = (_essayQuestions != null && qIndex < _essayQuestions.Count) ? _essayQuestions[qIndex] : null;
            string cauHoiId = (currentQ != null) ? currentQ.cauHoiID : "TL_C1_L2_Duy";
            string activeStep = _tutorActiveStepIds.ContainsKey(qIndex) ? _tutorActiveStepIds[qIndex] : "";

            List<TutorChatMessage> priorHistory = new List<TutorChatMessage>();
            if (_tutorChatHistories[qIndex].Count > 1)
            {
                priorHistory = _tutorChatHistories[qIndex].GetRange(0, _tutorChatHistories[qIndex].Count - 1);
            }

            var payload = new TutorChatRequestPayload
            {
                cauHoiId = cauHoiId,
                currentEssay = currentAnswer,
                studentMessage = text,
                activeStepId = activeStep,
                chatHistory = priorHistory
            };

            EssayGradingService.SendTutorChatAsync(payload, (res) =>
            {
                if (waitBubble != null) Destroy(waitBubble);

                if (_currentIndex != qIndex)
                {
                    if (res != null && res.success) SaveChatSessionResponse(qIndex, res);
                    return;
                }

                SetTutorInputInteractable(true);
                if (btnTutorSendText != null) btnTutorSendText.text = "GỬI";

                if (res == null || !res.success)
                {
                    if (tutorStepProgressText != null && (!_tutorCompletedStates.ContainsKey(qIndex) || !_tutorCompletedStates[qIndex]))
                    {
                        tutorStepProgressText.text = "Tiến độ bài làm: <color=#FF7043>Chưa kết nối AI</color>";
                    }
                    string errMsg = !string.IsNullOrEmpty(res?.message) ? res.message : (!string.IsNullOrEmpty(res?.error) ? res.error : "Không thể kết nối Gemini API.");
                    AddChatMessageBubble("system", $"⚠ Không thể kết nối Gia sư AI: {errMsg}\n<i>Bạn có thể nhập lại hoặc bấm <b>GỬI</b> để thử lại.</i>");
                    ScrollToBottomDelayed();
                    return;
                }

                SaveChatSessionResponse(qIndex, res);

                // Thêm bong bóng trả lời của Gia sư AI
                if (!string.IsNullOrEmpty(res.tutorReply))
                {
                    AddChatMessageBubble("assistant", res.tutorReply);
                }

                // Cập nhật Step Badges
                if (res.steps != null && res.steps.Count > 0)
                {
                    UpdateStepBadges(res.steps);
                }

                // Thông báo khi sửa đúng bước và đồng bộ bài làm
                if (res.isCurrentStepCorrect && !string.IsNullOrEmpty(res.updatedFullEssay))
                {
                    AddChatMessageBubble("system", "✓ <b>BƯỚC ĐÃ ĐƯỢC XÁC NHẬN ĐÚNG!</b> Bài làm tự luận bên ngoài đã được tự động cập nhật.");
                }

                if (res.isAllCompleted)
                {
                    AddChatMessageBubble("system", "🎉 <b>XUẤT SẮC! BẠN ĐÃ HOÀN THÀNH TOÀN BỘ CÁC BƯỚC CỦA BÀI NÀY!</b>");
                    if (_needsCorrection.ContainsKey(qIndex) && _needsCorrection[qIndex] &&
                        (!_hasCompletedCorrection.ContainsKey(qIndex) || !_hasCompletedCorrection[qIndex]))
                    {
                        AddChatMessageBubble("system", "📝 <i>Vì bài làm ban đầu còn điểm thiếu/sai sót, bạn hãy hoàn thành <b>Chép sửa kiến thức</b> một lần để ghi nhớ sâu nhé! Đang mở...</i>");
                        StartCoroutine(DelayedOpenKnowledgeCorrectionPopup(qIndex, 2.5f));
                    }
                    else
                    {
                        AddChatMessageBubble("system", "Bấm <b>ĐÓNG</b> để kiểm tra lại bài hoặc bấm <b>NỘP BÀI</b>.");
                    }
                }

                ScrollToBottomDelayed();

                if (tutorChatInputField != null && !res.isAllCompleted)
                {
                    tutorChatInputField.ActivateInputField();
                }
            });
        }

        private GameObject AddChatMessageBubble(string role, string text)
        {
            if (tutorChatContainer == null) return null;

            bool isAi = (role == "assistant" || role == "tutor" || role == "ai");
            bool isStudent = (role == "user" || role == "student");
            bool isSystem = (!isAi && !isStudent);

            // Cấu hình kích thước và padding chuẩn
            float bubbleWidth = isAi ? 1160f : (isStudent ? 1120f : 980f);
            float padLeft = isAi ? 140f : (isStudent ? 38f : 30f); // 140px cho AI để hoàn toàn vượt qua biểu tượng quyển sách bên trái
            float padRight = isAi ? 38f : (isStudent ? 148f : 30f); // 148px cho Học sinh để hoàn toàn tránh avatar icon bên phải
            float padTop = isAi ? 22f : (isStudent ? 54f : 16f); // 54px cho Học sinh để text bắt đầu HOÀN TOÀN DƯỚI thẻ tên vàng (y = -8..-54px)
            float padBottom = isAi ? 24f : (isStudent ? 24f : 16f);
            float spacing = isAi ? 8f : 0f;

            float textWidth = bubbleWidth - padLeft - padRight;

            // 1. Tạo MessageRow chứa tin nhắn trong Content của ScrollView
            GameObject rowGo = new GameObject($"MessageRow_{tutorChatContainer.childCount + 1}_{role}");
            rowGo.transform.SetParent(tutorChatContainer, false);
            RectTransform rowRt = rowGo.AddComponent<RectTransform>();
            rowRt.anchorMin = new Vector2(0f, 1f);
            rowRt.anchorMax = new Vector2(1f, 1f);
            rowRt.pivot = new Vector2(0.5f, 1f);

            // 2. Tạo Bong bóng chat bên trong Row
            GameObject bubble = new GameObject(isAi ? "AiBubble" : (isStudent ? "StudentBubble" : "SystemBubble"));
            bubble.transform.SetParent(rowGo.transform, false);
            RectTransform bRt = bubble.AddComponent<RectTransform>();

            // Định vị căn lề cho bong bóng
            if (isAi)
            {
                bRt.anchorMin = new Vector2(0f, 1f);
                bRt.anchorMax = new Vector2(0f, 1f);
                bRt.pivot = new Vector2(0f, 1f);
                bRt.anchoredPosition = new Vector2(8f, 0f);
            }
            else if (isStudent)
            {
                bRt.anchorMin = new Vector2(1f, 1f);
                bRt.anchorMax = new Vector2(1f, 1f);
                bRt.pivot = new Vector2(1f, 1f);
                bRt.anchoredPosition = new Vector2(-8f, 0f);
            }
            else
            {
                bRt.anchorMin = new Vector2(0.5f, 1f);
                bRt.anchorMax = new Vector2(0.5f, 1f);
                bRt.pivot = new Vector2(0.5f, 1f);
                bRt.anchoredPosition = new Vector2(0f, 0f);
            }

            Image bImg = bubble.AddComponent<Image>();
            bImg.raycastTarget = false;

            if (isAi)
            {
                if (_aiBubbleSprite != null)
                {
                    bImg.sprite = _aiBubbleSprite;
                    bImg.type = Image.Type.Sliced;
                    bImg.color = Color.white;
                }
                else
                {
                    bImg.color = new Color(0.06f, 0.14f, 0.28f, 0.95f);
                }
            }
            else if (isStudent)
            {
                if (_studentBubbleSprite != null)
                {
                    bImg.sprite = _studentBubbleSprite;
                    bImg.type = Image.Type.Sliced;
                    bImg.color = Color.white;
                }
                else
                {
                    bImg.color = new Color(0.96f, 0.82f, 0.38f, 0.95f);
                }
            }
            else
            {
                bImg.color = new Color(0.05f, 0.18f, 0.20f, 0.94f);
                var ol = bubble.AddComponent<Outline>();
                ol.effectColor = new Color(0.35f, 0.88f, 0.55f, 0.85f);
                ol.effectDistance = new Vector2(1f, -1f);
            }

            // VerticalLayoutGroup quản lý tiêu đề và nội dung bên trong bong bóng
            VerticalLayoutGroup vlg = bubble.AddComponent<VerticalLayoutGroup>();
            vlg.padding = new RectOffset((int)padLeft, (int)padRight, (int)padTop, (int)padBottom);
            vlg.spacing = spacing;
            vlg.childControlWidth = true;
            vlg.childControlHeight = true;
            vlg.childForceExpandWidth = true;
            vlg.childForceExpandHeight = false;

            float headerHeight = 0f;

            // 3. Tiêu đề người gửi
            if (isAi)
            {
                // Bong bóng AI: Tiêu đề "Gia sư AI Aurelia" màu vàng kim ở góc trên bên trái (sau icon sách)
                GameObject hdrGo = new GameObject("Header");
                hdrGo.transform.SetParent(bubble.transform, false);
                var hdrTmp = hdrGo.AddComponent<TextMeshProUGUI>();
                if (_defaultFont != null) hdrTmp.font = _defaultFont;
                hdrTmp.fontSize = 24;
                hdrTmp.fontStyle = FontStyles.Bold;
                hdrTmp.color = new Color(1f, 0.84f, 0f, 1f);
                hdrTmp.text = "Gia sư AI Aurelia";
                hdrTmp.alignment = TextAlignmentOptions.TopLeft;
                hdrTmp.raycastTarget = false;

                Vector2 hdrPref = hdrTmp.GetPreferredValues(hdrTmp.text, textWidth, float.PositiveInfinity);
                headerHeight = Mathf.Max(28f, hdrPref.y);

                LayoutElement hdrLe = hdrGo.AddComponent<LayoutElement>();
                hdrLe.preferredHeight = headerHeight;
                hdrLe.minHeight = headerHeight;
            }
            else if (isStudent)
            {
                // Bong bóng Học sinh: Nhãn người gửi "Bạn" nằm CHÍNH GIỮA thẻ tên vàng nhỏ ở góc TRÊN BÊN PHẢI
                GameObject tagGo = new GameObject("NameTag_Student");
                tagGo.transform.SetParent(bubble.transform, false);

                RectTransform tagRt = tagGo.AddComponent<RectTransform>();
                tagRt.anchorMin = new Vector2(1f, 1f);
                tagRt.anchorMax = new Vector2(1f, 1f);
                tagRt.pivot = new Vector2(0.5f, 0.5f);
                // Vị trí tâm thẻ tên vàng trong sprite fantasy_14: X=-208px từ mép phải, Y=-31px từ mép trên
                tagRt.anchoredPosition = new Vector2(-208f, -31f);
                tagRt.sizeDelta = new Vector2(140f, 36f);

                // Image vô hình để đại diện cho thẻ tên, không che phủ hoa văn vàng fantasy
                Image tagImg = tagGo.AddComponent<Image>();
                tagImg.color = Color.clear;
                tagImg.raycastTarget = false;

                // Thẻ tên không phụ thuộc vào VerticalLayoutGroup, luôn ghim cố định ở góc trên bên phải
                LayoutElement tagLe = tagGo.AddComponent<LayoutElement>();
                tagLe.ignoreLayout = true;

                // Chữ "Bạn" căn giữa hoàn toàn trong thẻ tên
                GameObject tagTextGo = new GameObject("Text_StudentSender");
                tagTextGo.transform.SetParent(tagGo.transform, false);
                RectTransform textRt = tagTextGo.AddComponent<RectTransform>();
                textRt.anchorMin = Vector2.zero;
                textRt.anchorMax = Vector2.one;
                textRt.offsetMin = Vector2.zero;
                textRt.offsetMax = Vector2.zero;

                var tagTmp = tagTextGo.AddComponent<TextMeshProUGUI>();
                if (_defaultFont != null) tagTmp.font = _defaultFont;
                tagTmp.fontSize = 24;
                tagTmp.fontStyle = FontStyles.Bold;
                tagTmp.color = new Color(0.20f, 0.12f, 0.04f, 1f); // Màu nâu đậm nghệ thuật fantasy sắc nét trên nền thẻ vàng
                tagTmp.text = "Bạn";
                tagTmp.alignment = TextAlignmentOptions.Center;
                tagTmp.raycastTarget = false;
            }

            // 4. Nội dung tin nhắn (tính chiều cao thực tế bằng GetPreferredValues theo đúng bề rộng)
            GameObject bodyGo = new GameObject("Body");
            bodyGo.transform.SetParent(bubble.transform, false);
            var bodyTmp = bodyGo.AddComponent<TextMeshProUGUI>();
            if (_defaultFont != null) bodyTmp.font = _defaultFont;
            bodyTmp.fontSize = 22;
            bodyTmp.fontStyle = isSystem ? FontStyles.Italic : FontStyles.Normal;
            bodyTmp.color = isAi ? new Color(0.92f, 0.96f, 1f, 1f) : (isStudent ? new Color(0.10f, 0.08f, 0.04f, 1f) : new Color(0.85f, 0.98f, 0.90f, 1f));
            bodyTmp.alignment = isSystem ? TextAlignmentOptions.Center : TextAlignmentOptions.TopLeft;
            bodyTmp.textWrappingMode = TextWrappingModes.Normal;
            bodyTmp.overflowMode = TextOverflowModes.Overflow;
            bodyTmp.lineSpacing = 6f;
            bodyTmp.raycastTarget = false;
            bodyTmp.text = text;

            Vector2 bodyPref = bodyTmp.GetPreferredValues(text, textWidth, float.PositiveInfinity);
            float bodyHeight = Mathf.Max(26f, bodyPref.y + 4f);

            LayoutElement bodyLe = bodyGo.AddComponent<LayoutElement>();
            bodyLe.preferredHeight = bodyHeight;
            bodyLe.minHeight = bodyHeight;
            bodyLe.preferredWidth = textWidth;

            // 5. Tính toán chính xác tổng chiều cao bong bóng
            float totalBubbleHeight;
            if (isAi)
            {
                totalBubbleHeight = padTop + headerHeight + (headerHeight > 0 ? spacing : 0f) + bodyHeight + padBottom;
                if (totalBubbleHeight < 140f) totalBubbleHeight = 140f;
            }
            else if (isStudent)
            {
                // Học sinh: Thẻ tên nằm ở góc trên bên phải, nội dung bắt đầu từ padTop (54px)
                totalBubbleHeight = padTop + bodyHeight + padBottom;
                if (totalBubbleHeight < 135f) totalBubbleHeight = 135f; // Đảm bảo chiều cao tối thiểu giữ trọn vẹn avatar
            }
            else
            {
                totalBubbleHeight = padTop + bodyHeight + padBottom;
                if (totalBubbleHeight < 70f) totalBubbleHeight = 70f;
            }

            // Thiết lập kích thước chính xác cho bong bóng và hàng chứa
            bRt.sizeDelta = new Vector2(bubbleWidth, totalBubbleHeight);
            rowRt.sizeDelta = new Vector2(0f, totalBubbleHeight);

            LayoutElement rowLe = rowGo.AddComponent<LayoutElement>();
            rowLe.preferredHeight = totalBubbleHeight;
            rowLe.minHeight = totalBubbleHeight;

            // 6. Cập nhật Layout ngay lập tức cho hàng vừa tạo
            Canvas.ForceUpdateCanvases();
            LayoutRebuilder.ForceRebuildLayoutImmediate(rowRt);
            if (tutorChatContainer != null)
            {
                LayoutRebuilder.ForceRebuildLayoutImmediate(tutorChatContainer);
            }

            return rowGo;
        }

        private void UpdateStepBadges(List<TutorChatStepData> steps)
        {
            if (steps == null || steps.Count == 0) return;

            int totalSteps = steps.Count;
            int correctCount = 0;
            for (int i = 0; i < steps.Count; i++)
            {
                if (steps[i].status == "correct") correctCount++;
            }

            // 1. Cập nhật chữ cố định "Tiến độ bài làm: X/Y bước"
            if (tutorStepProgressText != null)
            {
                string statusSuffix = (correctCount >= totalSteps) ? " <color=#4ade80>(Hoàn thành xuất sắc!)</color>" : "";
                tutorStepProgressText.text = $"Tiến độ bài làm: <b>{correctCount}/{totalSteps} bước</b>{statusSuffix}";
            }

            // 2. Cập nhật từng thẻ bước
            for (int i = 0; i < totalSteps; i++)
            {
                var s = steps[i];

                // Nếu số bước rubric nhiều hơn số badge ban đầu trong scene:
                if (i >= _stepBadgeRoots.Count && _stepBadgeRoots.Count > 0)
                {
                    var templateBadge = _stepBadgeRoots[0];
                    GameObject newBadge = Instantiate(templateBadge, templateBadge.transform.parent, false);
                    newBadge.name = $"Badge_Step{i + 1}";
                    RectTransform rt = newBadge.GetComponent<RectTransform>();
                    RectTransform t0 = templateBadge.GetComponent<RectTransform>();
                    float spacing = 220f;
                    rt.anchoredPosition = new Vector2(t0.anchoredPosition.x + i * spacing, t0.anchoredPosition.y);

                    TextMeshProUGUI newTmp = newBadge.GetComponentInChildren<TextMeshProUGUI>();
                    if (newTmp == null)
                    {
                        var tParent = templateBadge.transform.parent;
                        Transform origText = tParent.Find("Text_Step1");
                        if (origText != null)
                        {
                            GameObject nTxtGo = Instantiate(origText.gameObject, tParent, false);
                            nTxtGo.name = $"Text_Step{i + 1}";
                            RectTransform ntRt = nTxtGo.GetComponent<RectTransform>();
                            RectTransform otRt = origText.GetComponent<RectTransform>();
                            ntRt.anchoredPosition = new Vector2(otRt.anchoredPosition.x + i * spacing, otRt.anchoredPosition.y);
                            newTmp = nTxtGo.GetComponent<TextMeshProUGUI>();
                        }
                    }

                    _stepBadgeRoots.Add(newBadge);
                    _stepBadgeTexts.Add(newTmp);
                }

                if (i < _stepBadgeRoots.Count && _stepBadgeRoots[i] != null)
                {
                    _stepBadgeRoots[i].SetActive(true);
                    var img = _stepBadgeRoots[i].GetComponent<Image>();

                    if (i < _stepBadgeTexts.Count && _stepBadgeTexts[i] != null)
                    {
                        _stepBadgeTexts[i].gameObject.SetActive(true);
                    }

                    // Màu xanh lá khi đúng, đỏ khi sai, vàng cam khi làm dở, xám khi chưa làm.
                    // TUYỆT ĐỐI không dùng ký tự unicode như ✓ hay ✕ vì font không hỗ trợ gây lỗi ô vuông.
                    switch (s.status)
                    {
                        case "correct":
                            if (_badgeSpriteCorrect != null && img != null) img.sprite = _badgeSpriteCorrect;
                            if (img != null) img.color = new Color(0.35f, 0.95f, 0.55f, 1f); // Xanh lá
                            if (i < _stepBadgeTexts.Count && _stepBadgeTexts[i] != null)
                            {
                                _stepBadgeTexts[i].color = Color.white;
                                _stepBadgeTexts[i].text = $"BƯỚC {i + 1}";
                            }
                            break;

                        case "incorrect":
                            if (_badgeSpriteIncorrect != null && img != null) img.sprite = _badgeSpriteIncorrect;
                            if (img != null) img.color = new Color(1f, 0.35f, 0.35f, 1f); // Đỏ
                            if (i < _stepBadgeTexts.Count && _stepBadgeTexts[i] != null)
                            {
                                _stepBadgeTexts[i].color = new Color(1f, 0.90f, 0.90f, 1f);
                                _stepBadgeTexts[i].text = $"BƯỚC {i + 1}";
                            }
                            break;

                        case "partial":
                            if (_badgeSpriteIncorrect != null && img != null) img.sprite = _badgeSpriteIncorrect;
                            if (img != null) img.color = new Color(1f, 0.82f, 0.28f, 1f); // Vàng cam
                            if (i < _stepBadgeTexts.Count && _stepBadgeTexts[i] != null)
                            {
                                _stepBadgeTexts[i].color = Color.white;
                                _stepBadgeTexts[i].text = $"BƯỚC {i + 1}";
                            }
                            break;

                        default: // unassessable
                            if (_badgeSpriteIncorrect != null && img != null) img.sprite = _badgeSpriteIncorrect;
                            if (img != null) img.color = new Color(0.55f, 0.60f, 0.70f, 0.85f); // Xám
                            if (i < _stepBadgeTexts.Count && _stepBadgeTexts[i] != null)
                            {
                                _stepBadgeTexts[i].color = new Color(0.80f, 0.85f, 0.95f, 0.80f);
                                _stepBadgeTexts[i].text = $"BƯỚC {i + 1}";
                            }
                            break;
                    }
                }
            }

            // Nếu câu này có ít bước hơn số badge (ví dụ bài 2 bước thay vì 3 bước):
            for (int i = totalSteps; i < _stepBadgeRoots.Count; i++)
            {
                if (_stepBadgeRoots[i] != null) _stepBadgeRoots[i].SetActive(false);
                if (i < _stepBadgeTexts.Count && _stepBadgeTexts[i] != null) _stepBadgeTexts[i].gameObject.SetActive(false);
            }
        }

        private void ClearChatContainer()
        {
            if (tutorChatContainer == null) return;
            for (int i = tutorChatContainer.childCount - 1; i >= 0; i--)
            {
                var child = tutorChatContainer.GetChild(i).gameObject;
                child.transform.SetParent(null);
                Destroy(child);
            }
        }

        private void SetTutorInputInteractable(bool state)
        {
            if (tutorChatInputField != null) tutorChatInputField.interactable = state;
            if (btnTutorSend != null) btnTutorSend.interactable = state;
        }

        private void ScrollToBottomDelayed()
        {
            if (gameObject.activeInHierarchy)
            {
                StartCoroutine(DoScrollToBottom());
            }
        }

        private IEnumerator DoScrollToBottom()
        {
            yield return null;
            Canvas.ForceUpdateCanvases();
            if (tutorChatContainer != null)
            {
                LayoutRebuilder.ForceRebuildLayoutImmediate(tutorChatContainer);
            }
            yield return null;
            Canvas.ForceUpdateCanvases();
            if (tutorChatScrollRect != null)
            {
                tutorChatScrollRect.verticalNormalizedPosition = 0f;
            }
            if (tutorChatScrollbar != null)
            {
                tutorChatScrollbar.value = 0f;
            }
        }

        #endregion

        
        #region === KNOWLEDGE CORRECTION MODAL (CHÉP SỬA KIẾN THỨC) ===

        private void OnTutorDismissClicked()
        {
            SetTutorModalVisible(false);
            if (_needsCorrection.ContainsKey(_currentIndex) && _needsCorrection[_currentIndex] &&
                (!_hasCompletedCorrection.ContainsKey(_currentIndex) || !_hasCompletedCorrection[_currentIndex]) &&
                _tutorCompletedStates.ContainsKey(_currentIndex) && _tutorCompletedStates[_currentIndex])
            {
                OpenKnowledgeCorrectionPopup(_currentIndex);
            }
        }

        private IEnumerator DelayedOpenKnowledgeCorrectionPopup(int qIndex, float delay)
        {
            yield return new WaitForSeconds(delay);
            if (_needsCorrection.ContainsKey(qIndex) && _needsCorrection[qIndex] &&
                (!_hasCompletedCorrection.ContainsKey(qIndex) || !_hasCompletedCorrection[qIndex]))
            {
                SetTutorModalVisible(false);
                OpenKnowledgeCorrectionPopup(qIndex);
            }
        }

        /// <summary>
        /// Đồng bộ hiển thị popup Chép sửa kiến thức và quản lý chặn raycast.
        /// </summary>
        public void SetKnowledgeCorrectionModalVisible(bool visible)
        {
            if (correctionModalRoot == null) return;

            if (_correctionCanvasGroup == null)
            {
                _correctionCanvasGroup = GetOrAddComponent<CanvasGroup>(correctionModalRoot);
            }

            if (_correctionCanvasGroup != null)
            {
                _correctionCanvasGroup.alpha = visible ? 1f : 0f;
                _correctionCanvasGroup.interactable = visible;
                _correctionCanvasGroup.blocksRaycasts = visible;
            }

            var rootImg = correctionModalRoot.GetComponent<Image>();
            if (rootImg != null)
            {
                rootImg.raycastTarget = visible;
                rootImg.color = new Color(0.02f, 0.04f, 0.08f, 0.88f);
            }

            correctionModalRoot.SetActive(visible);

            var timerUI = StudySessionTimerUI.Instance ?? FindAnyObjectByType<StudySessionTimerUI>();
            if (timerUI != null)
            {
                timerUI.SetBadgeVisible(!visible);
            }

            if (visible)
            {
                correctionModalRoot.transform.SetAsLastSibling();
                if (correctionInputField != null)
                {
                    correctionInputField.ActivateInputField();
                }
            }

            Debug.Log($"[WrittenAnswerController] SetKnowledgeCorrectionModalVisible: {visible}");
        }

        /// <summary>
        /// Khởi tạo và liên kết trực tiếp với Popup Chép sửa kiến thức người dùng đã thiết kế trong Unity.
        /// TUYỆT ĐỐI không tự sinh modal mới đè lên thiết kế của người dùng.
        /// </summary>
        private void InitKnowledgeCorrectionModal()
        {
            Canvas canvas = GetComponentInParent<Canvas>() ?? FindAnyObjectByType<Canvas>();
            if (canvas == null) return;

            // Tìm GameObject "Chép sửa kiến thức"
            Transform modalTf = canvas.transform.Find("Chép sửa kiến thức");
            if (modalTf == null)
            {
                for (int i = 0; i < canvas.transform.childCount; i++)
                {
                    var child = canvas.transform.GetChild(i);
                    if (child.name.IndexOf("Chép", StringComparison.OrdinalIgnoreCase) >= 0 ||
                        child.name.IndexOf("Chep", StringComparison.OrdinalIgnoreCase) >= 0 ||
                        child.name.IndexOf("kiến thức", StringComparison.OrdinalIgnoreCase) >= 0)
                    {
                        modalTf = child;
                        break;
                    }
                }
            }

            if (modalTf == null)
            {
                Debug.LogWarning("[WrittenAnswerController] Không tìm thấy popup 'Chép sửa kiến thức' trong Canvas.");
                return;
            }

            correctionModalRoot = modalTf.gameObject;
            _correctionCanvasGroup = GetOrAddComponent<CanvasGroup>(correctionModalRoot);

            // 1. Khung 1: "Lời giải đúng" (Image (1) và Text (TMP))
            Transform modelTextTf = modalTf.Find("Text (TMP)");
            if (modelTextTf == null)
            {
                var tmps = modalTf.GetComponentsInChildren<TextMeshProUGUI>(true);
                foreach (var t in tmps)
                {
                    if (t.rectTransform.anchoredPosition.y > 0f)
                    {
                        modelTextTf = t.transform;
                        break;
                    }
                }
            }

            if (modelTextTf != null)
            {
                Transform oldVp = modalTf.Find("Viewport_ModelSolution");
                if (oldVp == null)
                {
                    GameObject vp = new GameObject("Viewport_ModelSolution");
                    vp.transform.SetParent(modalTf, false);
                    RectTransform vpRt = vp.AddComponent<RectTransform>();
                    vpRt.anchorMin = new Vector2(0.5f, 0.5f);
                    vpRt.anchorMax = new Vector2(0.5f, 0.5f);
                    vpRt.pivot = new Vector2(0.5f, 0.5f);
                    vpRt.anchoredPosition = new Vector2(4.48f, 32.46f);
                    vpRt.sizeDelta = new Vector2(826.8f, 140f);
                    vp.AddComponent<RectMask2D>();

                    ScrollRect sr = vp.AddComponent<ScrollRect>();
                    sr.horizontal = false;
                    sr.vertical = true;
                    sr.movementType = ScrollRect.MovementType.Clamped;
                    sr.scrollSensitivity = 25f;
                    sr.viewport = vpRt;

                    modelTextTf.SetParent(vpRt, false);
                    RectTransform mtRt = modelTextTf as RectTransform;
                    if (mtRt != null)
                    {
                        mtRt.anchorMin = new Vector2(0f, 1f);
                        mtRt.anchorMax = new Vector2(1f, 1f);
                        mtRt.pivot = new Vector2(0.5f, 1f);
                        mtRt.anchoredPosition = Vector2.zero;
                        mtRt.sizeDelta = new Vector2(0f, 0f);
                    }

                    var csf = GetOrAddComponent<ContentSizeFitter>(modelTextTf.gameObject);
                    csf.horizontalFit = ContentSizeFitter.FitMode.Unconstrained;
                    csf.verticalFit = ContentSizeFitter.FitMode.PreferredSize;

                    sr.content = mtRt;
                    correctionModelSolutionScrollRect = sr;
                }

                correctionModelSolutionText = modelTextTf.GetComponent<TextMeshProUGUI>();
                if (correctionModelSolutionText != null)
                {
                    correctionModelSolutionText.text = "";
                    correctionModelSolutionText.fontSize = 22f;
                    correctionModelSolutionText.color = new Color(0.16f, 0.12f, 0.08f, 1f);
                    correctionModelSolutionText.alignment = TextAlignmentOptions.TopLeft;
                    correctionModelSolutionText.textWrappingMode = TextWrappingModes.Normal;
                }
            }

            // 2. Khung 2: "Bài chép của em" (Image (2) và Text (TMP) (1))
            Transform stuTextTf = modalTf.Find("Text (TMP) (1)");
            if (stuTextTf == null)
            {
                var tmps = modalTf.GetComponentsInChildren<TextMeshProUGUI>(true);
                foreach (var t in tmps)
                {
                    if (t.rectTransform.anchoredPosition.y < 0f && t.name.IndexOf("Placeholder", StringComparison.OrdinalIgnoreCase) < 0)
                    {
                        stuTextTf = t.transform;
                        break;
                    }
                }
            }

            Transform img2Tf = modalTf.Find("Image (2)") ?? FindChildNear(modalTf, new Vector2(-8.62f, -176.02f));
            if (img2Tf != null && stuTextTf != null)
            {
                Transform oldVp2 = modalTf.Find("Viewport_CorrectionInput");
                RectTransform vp2Rt;
                if (oldVp2 == null)
                {
                    GameObject vp2 = new GameObject("Viewport_CorrectionInput");
                    vp2.transform.SetParent(modalTf, false);
                    vp2Rt = vp2.AddComponent<RectTransform>();
                    vp2Rt.anchorMin = new Vector2(0.5f, 0.5f);
                    vp2Rt.anchorMax = new Vector2(0.5f, 0.5f);
                    vp2Rt.pivot = new Vector2(0.5f, 0.5f);
                    // Safe area: chừa hoàn toàn bong bóng tiêu đề ở góc trên-trái và bút lông ở góc dưới-phải
                    vp2Rt.anchoredPosition = new Vector2(-35f, -191f);
                    vp2Rt.sizeDelta = new Vector2(760f, 135f);
                    vp2.AddComponent<RectMask2D>();

                    stuTextTf.SetParent(vp2Rt, false);
                }
                else
                {
                    vp2Rt = oldVp2 as RectTransform;
                }

                RectTransform stRt = stuTextTf as RectTransform;
                if (stRt != null)
                {
                    stRt.anchorMin = Vector2.zero;
                    stRt.anchorMax = Vector2.one;
                    stRt.pivot = new Vector2(0.5f, 0.5f);
                    stRt.offsetMin = Vector2.zero;
                    stRt.offsetMax = Vector2.zero;
                }

                var stuTmp = stuTextTf.GetComponent<TextMeshProUGUI>();
                if (stuTmp != null)
                {
                    stuTmp.text = "";
                    stuTmp.fontSize = 22f;
                    stuTmp.color = new Color(0.16f, 0.12f, 0.08f, 1f);
                    stuTmp.alignment = TextAlignmentOptions.TopLeft;
                    stuTmp.textWrappingMode = TextWrappingModes.Normal;
                }

                // Placeholder
                Transform phTf = vp2Rt.Find("Placeholder");
                TextMeshProUGUI phTmp;
                if (phTf == null)
                {
                    GameObject phGo = new GameObject("Placeholder");
                    phGo.transform.SetParent(vp2Rt, false);
                    RectTransform phRt = phGo.AddComponent<RectTransform>();
                    phRt.anchorMin = Vector2.zero;
                    phRt.anchorMax = Vector2.one;
                    phRt.pivot = new Vector2(0.5f, 0.5f);
                    phRt.offsetMin = Vector2.zero;
                    phRt.offsetMax = Vector2.zero;

                    phTmp = phGo.AddComponent<TextMeshProUGUI>();
                    phTmp.text = "<i>Gõ lại bài giải đúng tại đây để ghi nhớ...</i>";
                    phTmp.fontSize = 22f;
                    phTmp.color = new Color(0.48f, 0.42f, 0.35f, 0.70f);
                    phTmp.alignment = TextAlignmentOptions.TopLeft;
                    phTmp.textWrappingMode = TextWrappingModes.Normal;
                }
                else
                {
                    phTmp = phTf.GetComponent<TextMeshProUGUI>();
                }

                correctionInputField = GetOrAddComponent<TMP_InputField>(img2Tf);
                correctionInputField.textViewport = vp2Rt;
                correctionInputField.textComponent = stuTmp;
                correctionInputField.placeholder = phTmp;
                correctionInputField.lineType = TMP_InputField.LineType.MultiLineNewline;
                correctionInputField.pointSize = 22f;
                correctionInputField.selectionColor = new Color(0.85f, 0.70f, 0.30f, 0.4f);
                correctionInputField.caretColor = new Color(0.2f, 0.15f, 0.08f, 1f);
                correctionInputField.caretWidth = 2;
                correctionInputField.customCaretColor = true;
            }

            // 3. Nút "HOÀN THÀNH CHÉP SỬA" (Image (3))
            Transform btnConfirmTf = modalTf.Find("Image (3)") ?? FindChildNear(modalTf, new Vector2(-230.86f, -477.69f));
            if (btnConfirmTf != null)
            {
                btnCorrectionConfirm = GetOrAddComponent<Button>(btnConfirmTf);
                btnCorrectionConfirm.targetGraphic = btnConfirmTf.GetComponent<Image>();
                btnCorrectionConfirm.onClick.RemoveAllListeners();
                btnCorrectionConfirm.onClick.AddListener(OnConfirmCorrectionClicked);
                UIHoverPulseEffect.Attach(btnConfirmTf.gameObject, hover: 1.05f, minPulse: 1.02f, maxPulse: 1.06f, outline: true);
            }

            // 4. Nút "HỦY" (Image (4))
            Transform btnCancelTf = modalTf.Find("Image (4)") ?? FindChildNear(modalTf, new Vector2(256.91f, -477.69f));
            if (btnCancelTf != null)
            {
                btnCorrectionCancel = GetOrAddComponent<Button>(btnCancelTf);
                btnCorrectionCancel.targetGraphic = btnCancelTf.GetComponent<Image>();
                btnCorrectionCancel.onClick.RemoveAllListeners();
                btnCorrectionCancel.onClick.AddListener(OnCancelCorrectionClicked);
                UIHoverPulseEffect.Attach(btnCancelTf.gameObject, hover: 1.05f, minPulse: 1.02f, maxPulse: 1.06f, outline: true);
            }

            // Đảm bảo các khung tương tác và nút bấm nằm trên lớp nền
            if (btnConfirmTf != null) btnConfirmTf.SetAsLastSibling();
            if (btnCancelTf != null) btnCancelTf.SetAsLastSibling();
            Transform v1 = modalTf.Find("Viewport_ModelSolution");
            if (v1 != null) v1.SetAsLastSibling();
            Transform v2 = modalTf.Find("Viewport_CorrectionInput");
            if (v2 != null) v2.SetAsLastSibling();

            SetKnowledgeCorrectionModalVisible(false);
            Debug.Log("[WrittenAnswerController] InitKnowledgeCorrectionModal khởi tạo thành công.");
        }

        private Transform FindChildNear(Transform parent, Vector2 targetPos, float tolerance = 60f)
        {
            if (parent == null) return null;
            for (int i = 0; i < parent.childCount; i++)
            {
                var c = parent.GetChild(i) as RectTransform;
                if (c != null)
                {
                    if (Vector2.Distance(c.anchoredPosition, targetPos) <= tolerance)
                    {
                        return c;
                    }
                }
            }
            return null;
        }

        /// <summary>
        /// Mở popup Chép sửa kiến thức cho câu hỏi chỉ định.
        /// </summary>
        public void OpenKnowledgeCorrectionPopup(int qIndex)
        {
            if (correctionModalRoot == null) InitKnowledgeCorrectionModal();
            if (correctionModalRoot == null) return;

            _correctionQuestionIndex = qIndex;

            // 1. Hiển thị lời giải đúng mẫu
            if (correctionModelSolutionText != null)
            {
                string sol = GetCleanModelSolution(qIndex);
                correctionModelSolutionText.text = sol;
                Canvas.ForceUpdateCanvases();
            }

            if (correctionModelSolutionScrollRect != null)
            {
                correctionModelSolutionScrollRect.verticalNormalizedPosition = 1f;
            }

            // 2. Nạp bản nháp đã nhập (nếu có)
            if (correctionInputField != null)
            {
                if (_correctionDrafts.ContainsKey(qIndex) && !string.IsNullOrEmpty(_correctionDrafts[qIndex]))
                {
                    correctionInputField.text = _correctionDrafts[qIndex];
                }
                else
                {
                    correctionInputField.text = "";
                }
            }

            SetKnowledgeCorrectionModalVisible(true);
        }

        private void OnConfirmCorrectionClicked()
        {
            int qIndex = _correctionQuestionIndex >= 0 ? _correctionQuestionIndex : _currentIndex;

            if (correctionInputField == null) return;
            string studentText = correctionInputField.text != null ? correctionInputField.text.Trim() : "";

            string modelSol = GetCleanModelSolution(qIndex);

            bool isAcceptable = VerifyPhysicsCorrection(studentText, modelSol, out string feedbackReason);
            if (!isAcceptable)
            {
                ShowToast(feedbackReason, ToastType.Warning, 4.0f);
                return;
            }

            // Ghi nhận hoàn thành chép sửa
            _hasCompletedCorrection[qIndex] = true;
            _correctionDrafts[qIndex] = studentText;

            ShowToast("🎉 Tuyệt vời! Em đã hoàn thành việc ghi nhớ và chép sửa kiến thức!", ToastType.Success, 3.5f);
            SetKnowledgeCorrectionModalVisible(false);
        }

        private void OnCancelCorrectionClicked()
        {
            int qIndex = _correctionQuestionIndex >= 0 ? _correctionQuestionIndex : _currentIndex;
            if (correctionInputField != null)
            {
                _correctionDrafts[qIndex] = correctionInputField.text;
            }

            SetKnowledgeCorrectionModalVisible(false);
            ShowToast("Đã đóng popup. Bản nháp chép sửa của bạn đã được lưu lại.", ToastType.Info, 3.0f);
        }

        private string GetCleanModelSolution(int qIndex)
        {
            if (_essayQuestions != null && qIndex >= 0 && qIndex < _essayQuestions.Count)
            {
                var q = _essayQuestions[qIndex];
                if (!string.IsNullOrWhiteSpace(q.dapAnMau))
                {
                    return CleanSolutionText(q.dapAnMau);
                }
                if (!string.IsNullOrWhiteSpace(q.giaiThich))
                {
                    return CleanSolutionText(q.giaiThich);
                }
            }

            // Fallback: rubric steps
            string cauHoiId = (_essayQuestions != null && qIndex >= 0 && qIndex < _essayQuestions.Count) ? _essayQuestions[qIndex].cauHoiID : "";
            if (!string.IsNullOrEmpty(cauHoiId))
            {
                var rubrics = GameDataRepository.GetRubricsForQuestion(cauHoiId);
                if (rubrics != null && rubrics.Count > 0)
                {
                    var sb = new System.Text.StringBuilder();
                    for (int i = 0; i < rubrics.Count; i++)
                    {
                        var r = rubrics[i];
                        if (sb.Length > 0) sb.Append("\\n\\n");
                        sb.Append($"<b>Bước {i + 1} ({r.criterionId}):</b> {r.yeuCau}");
                    }
                    return CleanSolutionText(sb.ToString());
                }
            }

            return "Lời giải tham khảo đang được cập nhật.";
        }

        private static string CleanSolutionText(string raw)
        {
            if (string.IsNullOrEmpty(raw)) return "";
            string cleaned = raw;
            cleaned = cleaned.Replace("\\\\Omega", "Ω").Replace("\\\\omega", "ω");
            cleaned = cleaned.Replace("\\\\times", "×").Replace("\\\\cdot", "·");
            cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"\\$(.*?)\\$", "$1");
            cleaned = cleaned.Replace("$", "");
            return cleaned.Trim();
        }

        private bool VerifyPhysicsCorrection(string studentText, string modelSolution, out string reason)
        {
            reason = "";
            if (string.IsNullOrWhiteSpace(studentText))
            {
                reason = "Em chưa nhập bài chép sửa. Vui lòng nhập nội dung trước khi bấm Hoàn thành!";
                return false;
            }

            string normStudent = NormalizeForComparison(studentText);
            string normModel = NormalizeForComparison(modelSolution);

            if (normStudent.Length < 12)
            {
                reason = "Nội dung chép sửa quá ngắn. Em hãy ghi lại đầy đủ lời giải đúng nhé!";
                return false;
            }

            var modelWords = normModel.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries)
                .Where(w => w.Length >= 3).Distinct().ToList();
            var studentWords = normStudent.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries)
                .Where(w => w.Length >= 3).Distinct().ToHashSet();

            if (modelWords.Count == 0)
            {
                return normStudent.Length >= 10;
            }

            int matchedWords = modelWords.Count(w => studentWords.Contains(w) || normStudent.Contains(w));
            float wordCoverage = (float)matchedWords / modelWords.Count;

            int unionCount = studentWords.Union(modelWords).Count();
            int intersectCount = studentWords.Intersect(modelWords).Count();
            float jaccard = unionCount > 0 ? (float)intersectCount / unionCount : 0f;

            var formulaTokens = ExtractFormulaTokens(normModel);
            int matchedFormulas = 0;
            if (formulaTokens.Count > 0)
            {
                matchedFormulas = formulaTokens.Count(f => normStudent.Contains(f));
            }
            float formulaCoverage = formulaTokens.Count > 0 ? (float)matchedFormulas / formulaTokens.Count : 1f;

            bool passed = (wordCoverage >= 0.35f && (jaccard >= 0.30f || formulaCoverage >= 0.40f)) ||
                          (jaccard >= 0.40f) ||
                          (formulaCoverage >= 0.65f && wordCoverage >= 0.25f);

            if (!passed)
            {
                reason = "Bài chép chưa đầy đủ hoặc còn thiếu công thức/đơn vị/ý nghĩa Vật lý chính xác. Em hãy kiểm tra lại theo Lời giải đúng bên trên nhé!";
                return false;
            }

            return true;
        }

        private static string NormalizeForComparison(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            string low = s.ToLowerInvariant();
            low = low.Replace("\\r", " ").Replace("\\n", " ").Replace("\\t", " ");
            var chars = low.ToCharArray();
            for (int i = 0; i < chars.Length; i++)
            {
                char c = chars[i];
                if (char.IsPunctuation(c) && c != '=' && c != '+' && c != '-' && c != '*' && c != '/' && c != '.')
                {
                    chars[i] = ' ';
                }
            }
            string result = new string(chars);
            result = System.Text.RegularExpressions.Regex.Replace(result, @"\\s+", " ").Trim();
            return result;
        }

        private static List<string> ExtractFormulaTokens(string normModel)
        {
            var list = new List<string>();
            var matches = System.Text.RegularExpressions.Regex.Matches(normModel, @"[a-z]\\s*=\\s*[a-z0-9\\.\\*\\+\\-\\/]+|[a-z0-9]{1,4}\\b");
            foreach (System.Text.RegularExpressions.Match m in matches)
            {
                string val = m.Value.Replace(" ", "");
                if (val.Length >= 1 && !list.Contains(val))
                {
                    list.Add(val);
                }
            }
            return list;
        }

        #endregion

        private void ShowOcrTranscriptModal(string text)
        {
            if (ocrModalRoot != null)
            {
                ocrModalRoot.transform.SetAsLastSibling();
                ocrModalRoot.SetActive(true);

                if (ocrTranscriptInput != null)
                {
                    string cleaned = CleanOcrTextForStudent(text);
                    ocrTranscriptInput.text = cleaned;
                    ocrTranscriptInput.caretPosition = 0;
                }

                var scrollMgr = ocrModalRoot.GetComponentInChildren<OcrTranscriptScrollManager>();
                if (scrollMgr != null)
                {
                    scrollMgr.RefreshLayout(true);
                    StartCoroutine(DelayedRefreshOcrModal(scrollMgr));
                }
            }
        }

        private IEnumerator DelayedRefreshOcrModal(OcrTranscriptScrollManager scrollMgr)
        {
            yield return null;
            if (scrollMgr != null)
            {
                scrollMgr.RefreshLayout(true);
            }
        }

        private static string CleanOcrTextForStudent(string raw)
        {
            if (string.IsNullOrEmpty(raw)) return "";
            string cleaned = raw;
            cleaned = cleaned.Replace("\\Omega", "Ω").Replace("\\omega", "ω");
            cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"\$(.*?)\$", "$1");
            cleaned = cleaned.Replace("$", "");
            return cleaned.Trim();
        }

        private void OnConfirmOcrClicked()
        {
            if (ocrTranscriptInput == null) return;
            string confirmedText = ocrTranscriptInput.text != null ? ocrTranscriptInput.text.Trim() : "";

            if (string.IsNullOrWhiteSpace(confirmedText))
            {
                ShowToast("⚠ Bản chữ đang trống! Vui lòng nhập hoặc kiểm tra nội dung bài làm.", ToastType.Warning, 3.5f);
                return;
            }

            if (ocrModalRoot != null) ocrModalRoot.SetActive(false);

            if (answerInputField != null)
            {
                string existing = answerInputField.text != null ? answerInputField.text.Trim() : "";
                if (string.IsNullOrEmpty(existing))
                {
                    answerInputField.text = confirmedText;
                    _userAnswers[_currentIndex] = confirmedText;
                    ShowToast($"✓ Đã đưa bản chữ nhận dạng vào bài làm Câu {_currentIndex + 1}!", ToastType.Success, 2.5f);
                }
                else
                {
                    ShowMergeChoiceModal(existing, confirmedText);
                }
            }
        }

        private void ShowMergeChoiceModal(string existingText, string ocrText)
        {
            Canvas canvas = GetComponentInParent<Canvas>() ?? FindAnyObjectByType<Canvas>();
            if (canvas == null) return;

            GameObject modalGo = new GameObject("MergeChoiceModal");
            modalGo.transform.SetParent(canvas.transform, false);

            RectTransform rt = modalGo.AddComponent<RectTransform>();
            rt.anchorMin = Vector2.zero;
            rt.anchorMax = Vector2.one;
            rt.sizeDelta = Vector2.zero;

            Image bg = modalGo.AddComponent<Image>();
            bg.color = new Color(0.04f, 0.08f, 0.16f, 0.88f);

            GameObject cardGo = new GameObject("Card");
            cardGo.transform.SetParent(modalGo.transform, false);
            RectTransform cRt = cardGo.AddComponent<RectTransform>();
            cRt.sizeDelta = new Vector2(560, 260);
            cRt.anchoredPosition = Vector2.zero;

            Image cImg = cardGo.AddComponent<Image>();
            cImg.color = new Color(0.08f, 0.14f, 0.28f, 0.98f);

            Outline outline = cardGo.AddComponent<Outline>();
            outline.effectColor = new Color(0.96f, 0.82f, 0.38f, 1f);
            outline.effectDistance = new Vector2(2, -2);

            GameObject msgGo = new GameObject("Message");
            msgGo.transform.SetParent(cardGo.transform, false);
            RectTransform mRt = msgGo.AddComponent<RectTransform>();
            mRt.anchoredPosition = new Vector2(0, 45);
            mRt.sizeDelta = new Vector2(500, 80);
            var msgTmp = msgGo.AddComponent<TextMeshProUGUI>();
            msgTmp.text = "Bạn đã có nội dung gõ tay trước đó.\nBạn muốn áp dụng bản chữ OCR này như thế nào?";
            msgTmp.fontSize = 19;
            msgTmp.alignment = TextAlignmentOptions.Center;
            msgTmp.color = Color.white;

            // Nút 1: Ghép vào cuối
            GameObject btnAppendGo = new GameObject("Btn_Append");
            btnAppendGo.transform.SetParent(cardGo.transform, false);
            RectTransform apRt = btnAppendGo.AddComponent<RectTransform>();
            apRt.anchoredPosition = new Vector2(-170, -50);
            apRt.sizeDelta = new Vector2(150, 44);
            Image apImg = btnAppendGo.AddComponent<Image>();
            apImg.color = new Color(0.2f, 0.6f, 0.3f, 1f);
            Button apBtn = btnAppendGo.AddComponent<Button>();
            apBtn.targetGraphic = apImg;
            GameObject apTxtGo = new GameObject("Text");
            apTxtGo.transform.SetParent(btnAppendGo.transform, false);
            var apTmp = apTxtGo.AddComponent<TextMeshProUGUI>();
            apTmp.text = "GHÉP CUỐI";
            apTmp.fontSize = 16;
            apTmp.fontStyle = FontStyles.Bold;
            apTmp.alignment = TextAlignmentOptions.Center;
            apTmp.color = Color.white;
            apTmp.raycastTarget = false;
            apBtn.onClick.AddListener(() =>
            {
                answerInputField.text = existingText + "\n\n" + ocrText;
                _userAnswers[_currentIndex] = answerInputField.text;
                Destroy(modalGo);
                ShowToast("✓ Đã ghép nội dung OCR vào cuối bài làm!", ToastType.Success, 2.5f);
            });

            // Nút 2: Thay toàn bộ
            GameObject btnReplaceGo = new GameObject("Btn_Replace");
            btnReplaceGo.transform.SetParent(cardGo.transform, false);
            RectTransform rpRt = btnReplaceGo.AddComponent<RectTransform>();
            rpRt.anchoredPosition = new Vector2(0, -50);
            rpRt.sizeDelta = new Vector2(150, 44);
            Image rpImg = btnReplaceGo.AddComponent<Image>();
            rpImg.color = new Color(0.8f, 0.35f, 0.2f, 1f);
